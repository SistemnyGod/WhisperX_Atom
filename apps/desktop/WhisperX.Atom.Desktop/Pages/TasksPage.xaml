<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="PageRoot" Padding="24,20,24,24" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Поручения" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Общий реестр задач из доступных совещаний" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Обновить" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,*,Auto" ColumnSpacing="8">
            <TextBox x:Name="SearchBox" PlaceholderText="Поиск по задаче, встрече или ответственному" Style="{StaticResource InputStyle}" TextChanged="SearchBox_TextChanged" />
            <ComboBox x:Name="StatusFilterBox" Grid.Column="1" PlaceholderText="Статус" SelectionChanged="StatusFilterBox_SelectionChanged">
                <ComboBoxItem Content="Активные" Tag="ACTIVE" IsSelected="True" />
                <ComboBoxItem Content="Все статусы" Tag="ALL" />
                <ComboBoxItem Content="На проверке" Tag="NEEDS_REVIEW" />
                <ComboBoxItem Content="Открытые" Tag="OPEN" />
                <ComboBoxItem Content="Готовые" Tag="DONE" />
                <ComboBoxItem Content="Отменённые" Tag="CANCELLED" />
            </ComboBox>
            <ComboBox x:Name="DeadlineFilterBox" Grid.Column="2" PlaceholderText="Срок" SelectionChanged="DeadlineFilterBox_SelectionChanged">
                <ComboBoxItem Content="Любой срок" Tag="ALL" IsSelected="True" />
                <ComboBoxItem Content="Просроченные" Tag="OVERDUE" />
                <ComboBoxItem Content="Сегодня" Tag="TODAY" />
                <ComboBoxItem Content="Ближайшие 7 дней" Tag="NEXT_7_DAYS" />
                <ComboBoxItem Content="Без срока" Tag="NO_DEADLINE" />
            </ComboBox>
            <ComboBox x:Name="MeetingFilterBox" Grid.Column="3" PlaceholderText="Совещание" SelectionChanged="MeetingFilterBox_SelectionChanged" />
            <TextBox x:Name="ResponsibleFilterBox" Grid.Column="4" Width="170" PlaceholderText="Ответственный" Style="{StaticResource InputStyle}" TextChanged="ResponsibleFilterBox_TextChanged" />
        </Grid>

        <Grid x:Name="TasksGrid" Grid.Row="2" ColumnDefinitions="*,360" RowDefinitions="*,0" ColumnSpacing="14" RowSpacing="14">
            <Border x:Name="ListCard" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Реестр поручений" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="TaskList" ItemsSource="{Binding FilteredItems}" SelectionMode="Single" SelectionChanged="TaskList_SelectionChanged" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,11">
                                        <Grid ColumnDefinitions="*,130,110" ColumnSpacing="12">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding TaskText}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding MeetingTitle}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="12" />
                                                <TextBlock Text="{Binding ResponsibleText}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DeadlineText}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Padding="18">
                            <SymbolIcon Symbol="Accept" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="Поручений нет" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock x:Name="EmptyDescription" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="DetailsCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Поручение" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="DetailsMeetingText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBox x:Name="TaskEditor" Header="Текст задачи" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" Style="{StaticResource InputStyle}" TextChanged="TaskEditor_TextChanged" />
                        <TextBox x:Name="ResponsibleEditor" Header="Ответственный" Style="{StaticResource InputStyle}" TextChanged="ResponsibleEditor_TextChanged" />
                        <DatePicker x:Name="DeadlinePicker" Header="Срок" DateChanged="DeadlinePicker_DateChanged" />
                        <CheckBox x:Name="NoDeadlineCheckBox" Content="Без срока" Checked="NoDeadlineCheckBox_Changed" Unchecked="NoDeadlineCheckBox_Changed" />
                        <ComboBox x:Name="StatusEditor" Header="Статус" SelectedValuePath="Content" SelectionChanged="StatusEditor_SelectionChanged">
                            <ComboBoxItem Content="NEEDS_REVIEW" />
                            <ComboBoxItem Content="OPEN" />
                            <ComboBoxItem Content="DONE" />
                            <ComboBoxItem Content="CANCELLED" />
                        </ComboBox>
                        <Button x:Name="SaveButton" Content="Сохранить изменения" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_Click" IsEnabled="False" />
                        <Button x:Name="EvidenceButton" Content="Открыть источник в стенограмме" Style="{StaticResource SecondaryButtonStyle}" Click="EvidenceButton_Click" Visibility="Collapsed" />
                        <TextBlock x:Name="DetailsEmptyText" Text="Выберите поручение слева." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Top" IsHitTestVisible="False">
            <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" IsClosable="True" />
            <InfoBar x:Name="WarningInfoBar" IsOpen="False" Severity="Warning" IsClosable="True" />
        </StackPanel>
        <ProgressRing x:Name="LoadingRing" Grid.Row="2" IsActive="False" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" />
    </Grid>
</Page>
