<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.AssistantPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource PageGap}">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
                <TextBlock Text="ИИ-помощник" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Постоянные диалоги по готовым стенограммам с подтверждёнными источниками" Foreground="{StaticResource MutedTextBrush}" />
                <ComboBox x:Name="ContextBox" Header="Контекст нового чата" ItemsSource="{Binding Contexts}" DisplayMemberPath="Label" Width="360" Margin="0,8,0,0" SelectionChanged="ContextBox_SelectionChanged" />
            </StackPanel>
            <Button x:Name="NewChatButton" Grid.Column="1" Content="Новый чат" Style="{StaticResource PrimaryButtonStyle}" Click="NewChatButton_Click" />
        </Grid>

        <InfoBar x:Name="ErrorInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Error" />

        <Grid x:Name="AssistantShell" Grid.Row="2" ColumnDefinitions="260,*,340" ColumnSpacing="12" SizeChanged="AssistantShell_SizeChanged">
            <Border x:Name="ConversationCard" Style="{StaticResource CardStyle}" Padding="12">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <TextBlock Text="Чаты" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Grid.Row="1" Text="Контекст фиксируется при создании чата" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                    <ListView x:Name="ConversationsList" Grid.Row="2" ItemsSource="{Binding Conversations}" SelectionMode="Single" SelectionChanged="ConversationsList_SelectionChanged" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{Binding ContextLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                    <Button Grid.Column="1" Content="⋯" Tag="{Binding}" Style="{StaticResource IconButtonStyle}" Click="ConversationMenuButton_Click" AutomationProperties.Name="Действия чата" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border x:Name="ChatCard" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16">
                <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Диалог" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="ContextText" Text="Выберите или создайте чат" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <ProgressRing x:Name="LoadingRing" Grid.Column="1" Width="22" Height="22" IsActive="False" />
                    </Grid>
                    <ListView x:Name="MessagesList" Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="Single" SelectionChanged="MessagesList_SelectionChanged" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="0,0,0,8" Background="{StaticResource SurfaceBlueBrush}" CornerRadius="8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ChatEmptyText" Grid.Row="1" Text="Выберите чат и задайте вопрос по стенограмме." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <TextBox x:Name="QuestionBox" Header="Вопрос" PlaceholderText="Задайте вопрос по совещанию" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Style="{StaticResource InputStyle}" TextChanged="QuestionBox_TextChanged" />
                        <Button x:Name="AskButton" Grid.Column="1" Content="Спросить" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Click="AskButton_Click" />
                    </Grid>
                    <TextBlock x:Name="StatusText" Grid.Row="3" Text="" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border x:Name="EvidenceCard" Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel Spacing="3">
                        <TextBlock Text="Источники" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Ответы без подтверждённых источников требуют проверки" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ListView x:Name="EvidenceList" Grid.Row="1" ItemsSource="{Binding Evidence}" SelectionMode="None" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="5" Padding="0,8">
                                    <TextBlock Text="{Binding Timecode}" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Speaker}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                    <Button Content="Открыть источник" Tag="{Binding}" Style="{StaticResource CardButtonStyle}" Click="OpenEvidenceButton_Click" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="EvidenceEmptyText" Grid.Row="1" Text="Источники появятся после ответа." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
