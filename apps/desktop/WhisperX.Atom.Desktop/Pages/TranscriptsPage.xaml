<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.TranscriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Стенограммы" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Поиск по реальным транскриптам, загруженным для встреч" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="ActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Открыть совещания" Style="{StaticResource SecondaryButtonStyle}" Click="OpenMeetingsButton_Click" />
                    <Button x:Name="RefreshButton" Content="Обновить" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Настройки подключения" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSettingsButton_Click" AutomationProperties.Name="Открыть настройки подключения к API" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="WarningInfoBar" IsOpen="False" Severity="Warning" IsClosable="False" />

            <Grid x:Name="WorkspaceGrid" ColumnDefinitions="*,390" RowDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="16" MinHeight="540">
                <Border x:Name="ListCard" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Реестр стенограмм" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1" x:Name="LoadingRing" Width="22" Height="22" IsActive="False" />
                        </Grid>
                        <TextBox x:Name="SearchBox" PlaceholderText="Поиск по названию или описанию встречи" Margin="20,0,20,14" Style="{StaticResource InputStyle}" TextChanged="SearchBox_TextChanged" />
                        <Grid Background="{StaticResource TableHeaderBrush}" Padding="20,10" ColumnDefinitions="1.6*,130,80,110">
                            <TextBlock Text="Встреча" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="1" Text="Дата" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="2" Text="Сегменты" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="3" Text="Статус" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                        </Grid>
                        <ListView x:Name="TranscriptsList" ItemsSource="{Binding FilteredItems}" SelectionMode="Single" BorderThickness="0" SelectionChanged="TranscriptsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="20,12" ColumnDefinitions="1.6*,130,80,110">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MeetingTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding MeetingDateText}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding SegmentCountText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Padding="20,34" Spacing="8" HorizontalAlignment="Center" MaxWidth="520">
                            <SymbolIcon Symbol="Document" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="Стенограмм нет" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDescription" Text="После обработки встречи её транскрипт появится здесь." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button x:Name="EmptyRetryButton" Content="Повторить загрузку" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" HorizontalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Повторить загрузку стенограмм" ToolTipService.ToolTip="Проверить API и повторить загрузку списка" />
                            <Button x:Name="EmptyClearSearchButton" Content="Сбросить поиск" Style="{StaticResource SecondaryButtonStyle}" Click="ClearSearchButton_Click" HorizontalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Сбросить поиск стенограмм" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DetailsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Выбранная стенограмма" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="DetailsTitle" Text="{Binding SelectedTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SelectedStatus}" FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Качество стенограммы" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding SelectedQualityText}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedQualityWarningText}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel x:Name="TranscriptDetails" Spacing="10">
                            <TextBox x:Name="SegmentSearchBox" PlaceholderText="Поиск по тексту" Style="{StaticResource InputStyle}" TextChanged="SegmentSearchBox_TextChanged" />
                            <ListView x:Name="SegmentsList" ItemsSource="{Binding FilteredSegments}" SelectionMode="Single" MaxHeight="390" SelectionChanged="SegmentsList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="10,8" ColumnDefinitions="72,*">
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource AccentBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="SegmentEmptyText" Text="Сегментов с таким текстом не найдено." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedSegmentText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <Button x:Name="OpenSegmentButton" Content="Открыть сегмент в совещании" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSegmentButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <TextBlock x:Name="DetailsEmptyText" Text="Выберите встречу, чтобы просмотреть её реальные сегменты." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
