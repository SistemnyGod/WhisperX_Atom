<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.SummariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Саммари" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Итоги встреч из существующего summary API" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="ActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Открыть совещания" Style="{StaticResource SecondaryButtonStyle}" Click="OpenMeetingsButton_Click" />
                    <Button x:Name="RefreshButton" Content="Обновить" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Настройки подключения" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSettingsButton_Click" AutomationProperties.Name="Открыть настройки подключения к API" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="WarningInfoBar" IsOpen="False" Severity="Warning" IsClosable="False" />

            <Grid x:Name="WorkspaceGrid" ColumnDefinitions="*,430" RowDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="16" MinHeight="540">
                <Border x:Name="ListCard" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Реестр саммари" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1" x:Name="LoadingRing" Width="22" Height="22" IsActive="False" />
                        </Grid>
                        <TextBox x:Name="SearchBox" PlaceholderText="Поиск по встрече или тексту саммари" Margin="20,0,20,14" Style="{StaticResource InputStyle}" TextChanged="SearchBox_TextChanged" />
                        <Grid Background="{StaticResource TableHeaderBrush}" Padding="20,10" ColumnDefinitions="1.4*,130,150">
                            <TextBlock Text="Встреча" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="1" Text="Статус" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="2" Text="Версия" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                        </Grid>
                        <ListView x:Name="SummariesList" ItemsSource="{Binding FilteredItems}" SelectionMode="Single" BorderThickness="0" SelectionChanged="SummariesList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="20,12" ColumnDefinitions="1.4*,130,150">
                                        <StackPanel>
                                            <TextBlock Text="{Binding MeetingTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MetaText}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding MeetingDateText}" Foreground="{StaticResource MutedTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" Padding="20,34" Spacing="8" HorizontalAlignment="Center" MaxWidth="520">
                            <SymbolIcon Symbol="Document" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="Саммари не найдены" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDescription" Text="После обработки встречи итог появится здесь." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                            <Button x:Name="EmptyRetryButton" Content="Повторить загрузку" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshButton_Click" HorizontalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Повторить загрузку саммари" ToolTipService.ToolTip="Проверить API и повторить загрузку списка" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DetailsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Итог встречи" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="DetailsTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailsMeta" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                        <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
                            <TextBlock x:Name="DetailsStatus" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock x:Name="DetailsReviewText" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        <StackPanel x:Name="SummaryDetails" Spacing="10">
                            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="22" />
                            </ScrollViewer>
                            <Button x:Name="RebuildButton" Content="Пересобрать саммари" Style="{StaticResource SecondaryButtonStyle}" Click="RebuildButton_Click" HorizontalAlignment="Stretch" />
                            <Button x:Name="OpenMeetingButton" Content="Открыть совещание" Style="{StaticResource CardButtonStyle}" Click="OpenMeetingButton_Click" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <TextBlock x:Name="DetailsEmptyText" Text="Выберите встречу, чтобы просмотреть её итог." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
