<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.ComingSoonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="40">
        <Border Style="{StaticResource CardStyle}" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="12">
                <TextBlock Text="В РАЗРАБОТКЕ" Style="{StaticResource EyebrowStyle}" Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="TitleText" Text="Раздел готовится" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="DescriptionText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="Основной рабочий цикл уже доступен: Главная → Запись → Совещания." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
