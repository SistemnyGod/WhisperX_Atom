<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.AgentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Агенты" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Состояние Recorder Agent и зарегистрированные подключения API" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="ActionsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Открыть настройки" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSettingsButton_Click" />
                    <Button x:Name="RefreshButton" Content="Обновить" Style="{StaticResource PrimaryButtonStyle}" Click="RefreshButton_Click" />
                </StackPanel>
            </Grid>

            <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" IsClosable="False" />
            <InfoBar x:Name="WarningInfoBar" IsOpen="False" Severity="Warning" IsClosable="False" />

            <Grid x:Name="SummaryGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
                <Border Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceBlueBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="API" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="{Binding ApiStatus}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Данные реестра обновляются через текущую сессию API" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="{StaticResource CaptionTextSize}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="ЗАРЕГИСТРИРОВАННЫЕ АГЕНТЫ" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="{Binding AgentCountText}" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Всего в доступном реестре" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="АКТИВНЫЕ" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="{Binding OnlineCountText}" FontSize="28" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                            <TextBlock Text="Недоступны:" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding UnavailableCountText}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="Отозваны:" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding RevokedCountText}" FontSize="{StaticResource CaptionTextSize}" />
                        </StackPanel>
                        <TextBlock Text="По статусу, который вернул API" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceGreenBrush}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="WHISPERX" Style="{StaticResource EyebrowStyle}" />
                        <TextBlock Text="{Binding ProcessingStatus}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding GpuStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryStatus}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="WorkspaceGrid" ColumnDefinitions="*,360" RowDefinitions="*,Auto" ColumnSpacing="16" RowSpacing="16" MinHeight="430">
                <Border x:Name="AgentsCard" Style="{StaticResource CardStyle}" Padding="0">
                    <StackPanel>
                        <Grid Padding="20,18" ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock Text="Реестр агентов" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Подключения для текущей сессии API" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ProgressRing Grid.Column="1" x:Name="LoadingRing" Width="22" Height="22" IsActive="False" />
                        </Grid>
                        <Grid Background="{StaticResource TableHeaderBrush}" Padding="20,10" ColumnDefinitions="1.4*,130,170,*">
                            <TextBlock Text="Имя" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="1" Text="Статус" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="2" Text="Последняя связь" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Grid.Column="3" Text="Комната" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                        </Grid>
                        <ListView x:Name="AgentsList" ItemsSource="{Binding Agents}" SelectionMode="Single" BorderThickness="0" SelectionChanged="AgentsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="20,12" ColumnDefinitions="1.4*,130,170,*">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding EffectiveStatusText}" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastSeenText}" Foreground="{StaticResource MutedTextBrush}" />
                                        <TextBlock Grid.Column="3" Text="{Binding RoomText}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="AgentsEmptyState" Padding="20,34" Spacing="6" HorizontalAlignment="Center">
                            <SymbolIcon Symbol="Contact" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyTitle" Text="Зарегистрированных агентов нет" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="EmptyDescription" Text="Войдите в API или зарегистрируйте Recorder Agent в настройках." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="DetailsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Выбранный агент" Style="{StaticResource SectionTitleStyle}" />
                        <StackPanel x:Name="AgentDetails" Spacing="10">
                            <TextBlock x:Name="DetailsName" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
                                <TextBlock x:Name="DetailsStatus" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Последняя связь" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                <TextBlock x:Name="DetailsLastSeen" />
                            </StackPanel>
                            <StackPanel Spacing="3">
                                <TextBlock Text="Комната" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                <TextBlock x:Name="DetailsRoom" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Text="Операции регистрации и подключения выполняются в разделе Настройки. Серверные действия управления агентом в этом этапе не добавляются." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="{StaticResource CaptionTextSize}" />
                        </StackPanel>
                        <TextBlock x:Name="DetailsEmptyText" Text="Выберите агента в списке, чтобы увидеть его последнее состояние." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Локальный Recorder Agent" Style="{StaticResource SectionTitleStyle}" />
                    <Border Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="LocalAgentDot" Width="10" Height="10" Fill="{StaticResource NeutralStatusBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LocalAgentStatus}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Text="Архив" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding ArchiveRoot}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Хранилище" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding StorageText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ожидают отправки" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding PendingUploadsText}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel>
                            <TextBlock Text="Микрофон" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding MicrophoneText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Системный звук" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <TextBlock Text="{Binding SystemAudioText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
