<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhisperX_Atom_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <controls:PageHeader Title="Запись" Subtitle="Выберите микрофон, проверьте сигнал и начните локальную запись">
                <controls:PageHeader.Actions>
                    <Button Content="Проверить устройства" Style="{StaticResource ToolbarButtonStyle}" Click="CheckDevicesButton_Click" AutomationProperties.Name="Проверить устройства записи" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border Style="{StaticResource CardStyle}" Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel>
                            <TextBlock Text="Управление записью" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Сначала проверьте микрофон — запись сохраняется локально и не зависит от сети." Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Top">
                            <TextBlock Text="ЛОКАЛЬНО" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <StackPanel x:Name="RecordingActionsPanel" Orientation="Horizontal" Spacing="8">
                        <Button Content="Начать запись" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanAttemptStart}" Click="StartButton_Click" AutomationProperties.Name="Начать запись" ToolTipService.ToolTip="Запустить локальную запись" />
                        <Button x:Name="PauseResumeButton" Content="Пауза" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanPause}" Click="PauseResumeButton_Click" ToolTipService.ToolTip="Приостановить или продолжить запись" />
                        <Button Content="Метка" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanMark}" Click="MarkerButton_Click" AutomationProperties.Name="Добавить метку" ToolTipService.ToolTip="Добавить временную метку" />
                        <Button Content="Решение" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanMark}" Click="DecisionButton_Click" AutomationProperties.Name="Добавить решение" ToolTipService.ToolTip="Зафиксировать решение встречи" />
                        <Button Content="Задача" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanMark}" Click="TaskButton_Click" AutomationProperties.Name="Добавить задачу" ToolTipService.ToolTip="Зафиксировать задачу встречи" />
                        <Button Content="Завершить" Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding CanStop}" Click="StopButton_Click" AutomationProperties.Name="Завершить запись" ToolTipService.ToolTip="Остановить запись и запустить сохранение" />
                    </StackPanel>
                    <TextBlock Text="{Binding StartReadinessMessage}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Состояние Recorder Agent" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AgentStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Настройки" Style="{StaticResource SecondaryButtonStyle}" Click="OpenSettingsButton_Click" VerticalAlignment="Center" AutomationProperties.Name="Открыть настройки Recorder Agent" ToolTipService.ToolTip="Проверить подключение Agent и локального сервиса" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Grid x:Name="RecordingHeroGrid" ColumnDefinitions="*,320" ColumnSpacing="16">
                <StackPanel x:Name="RecordingMainColumn" Spacing="{StaticResource PageGap}">
                    <Border x:Name="RecordingHeroCard" Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource HeroBorderBrush}" Padding="20">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="RecordingStateBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="RecordingStateBadgeText" Text="{Binding StateTitle}" FontSize="{StaticResource CaptionTextSize}" FontWeight="SemiBold" /></Border>
                                <TextBlock Text="СОСТОЯНИЕ ЗАПИСИ" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MediaTimeLabel}" FontSize="{StaticResource RecordingTimerTextSize}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding Title, Mode=TwoWay}" Style="{StaticResource InputStyle}" PlaceholderText="Название совещания" AutomationProperties.Name="Название совещания" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                                <Ellipse x:Name="StateIndicator" Width="12" Height="12" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateTitle}" Style="{StaticResource PageTitleStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Spacing="8">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <controls:AudioLevelMeter Label="Микрофон" Level="{Binding MicrophoneLevel}" DbText="{Binding MicrophoneDbLabel}" />
                                <controls:AudioWaveformMonitor Samples="{Binding MicrophoneWaveform}" SignalState="{Binding MicrophoneSignalState}" IsStale="{Binding MicrophoneTelemetryStale}" Height="74" />
                                <TextBlock Text="{Binding MicrophoneSignalLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding EffectiveMicrophoneLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MicrophoneTelemetryLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <InfoBar x:Name="ErrorInfoBar" IsOpen="False" IsClosable="False" Severity="Error">
                        <InfoBar.ActionButton><Button x:Name="RetryUploadInfoButton" Content="Повторить отправку" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanRetryUpload}" Click="RetryUploadButton_Click" AutomationProperties.Name="Повторить отправку записи" ToolTipService.ToolTip="Повторить доставку сохранённых аудиоданных" /></InfoBar.ActionButton>
                    </InfoBar>
                    <Button Content="Открыть локальный архив" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenLocalArchive}" Click="OpenArchiveButton_Click" HorizontalAlignment="Left" />
                    <InfoBar x:Name="WarningInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Локальное сохранение" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="{Binding LocalFinalizeStatusLabel}" Grid.Column="1" Foreground="{StaticResource SuccessBrush}" /></Grid>
                            <Grid x:Name="LifeCycleGrid" ColumnDefinitions="*,*,*,*,*" ColumnSpacing="8">
                                <TextBlock Text="1 · Проверка" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="2 · Первый аудиокадр" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="3 · Чанк сохранён" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="4 · Master FLAC" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="4" Text="5 · Доставка" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Text="{Binding DeliveryStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EncodingStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ArchiveStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding StorageWatermarkLabel}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="WhisperX обработка" Style="{StaticResource SectionTitleStyle}" /><TextBlock Text="Стенограмма появится после локального сохранения и доставки" Style="{StaticResource CaptionStyle}" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding ProcessingStatus}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" HorizontalTextAlignment="Right" /></Grid>
                            <controls:ProcessingStepper Steps="{Binding ProcessingSteps}" CurrentIndex="{Binding ProcessingStageIndex}" />
                            <ProgressBar Value="{Binding ProcessingProgress}" IsIndeterminate="{Binding IsProcessing}" Minimum="0" Maximum="100" />
                            <TextBlock Text="{Binding TranscriptStatus}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProcessingError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TranscriptPreview}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="3" />
                            <Button Content="Открыть стенограмму" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenTranscript}" Click="OpenTranscriptButton_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RecordingSourcesColumn" Grid.Column="1" Spacing="{StaticResource PageGap}">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="9">
                            <TextBlock Text="Источники записи" Style="{StaticResource SectionTitleStyle}" />
                            <controls:DeviceSelector x:Name="MicrophoneSelector" ItemsSource="{Binding Microphones}" DisplayMemberPath="DisplayName" IsSelectionEnabled="{Binding CanSelectDevices}" Label="Микрофон" HelperText="Выбор сохраняется после успешной проверки устройства." SelectionChanged="MicrophoneCombo_SelectionChanged" />
                            <Button Content="Проверить микрофон" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding CanTestAudio}" Click="TestMicrophoneButton_Click" AutomationProperties.Name="Проверить микрофон" />
                            <TextBlock Text="{Binding MicrophoneTestStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="Профиль записи" Style="{StaticResource WorkspaceLabelStyle}" Margin="0,6,0,0" />
                            <ComboBox x:Name="RecordingProfileSelector" ItemsSource="{Binding RecordingProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding RecordingProfile, Mode=OneWay}" IsEnabled="{Binding CanSelectRecordingProfile}" SelectionChanged="RecordingProfile_SelectionChanged" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Профиль записи" />
                            <TextBlock Text="ROOM / MIC_ONLY — основной профиль" Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Системный звук" Style="{StaticResource SectionTitleStyle}" />
                            <Border Background="{StaticResource SurfaceOrangeBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="Захват системного звука пока отложен в AudioGraph runtime; микрофон продолжает работать отдельно." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="1" Text="ПОЗЖЕ" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" />
                                </Grid>
                            </Border>
                            <controls:DeviceSelector x:Name="SystemAudioSelector" ItemsSource="{Binding SystemAudioDevices}" DisplayMemberPath="DisplayName" IsSelectionEnabled="{Binding SystemAudioCaptureAvailable}" Label="Источник системного звука" HelperText="Будет доступен после включения Process Loopback." SelectionChanged="SystemAudioCombo_SelectionChanged" />
                            <Button Content="Проверить системный звук" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding SystemAudioCaptureAvailable}" Click="TestSystemAudioButton_Click" AutomationProperties.Name="Проверить системный звук" />
                            <controls:AudioLevelMeter Label="Системный звук" Level="{Binding SystemAudioLevel}" DbText="{Binding SystemAudioDbLabel}" />
                            <controls:AudioWaveformMonitor Samples="{Binding SystemAudioWaveform}" IsStale="{Binding SystemAudioTelemetryStale}" Height="74" />
                            <TextBlock Text="{Binding SystemAudioTestStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SyncCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Доставка" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Локальная запись не зависит от сети. Непереданные chunks будут отправлены позже." Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding PendingUploadsLabel}" />
                            <TextBlock Text="{Binding ChunkSyncLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding PendingBytesLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding DeliveryDiagnosticLabel}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DeliveryTraceLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <Button x:Name="RetryUploadPanelButton" Content="Повторить отправку" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding CanRetryUpload}" Click="RetryUploadButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
