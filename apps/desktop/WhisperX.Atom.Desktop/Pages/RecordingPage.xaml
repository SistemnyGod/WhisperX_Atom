<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Запись" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Проверка устройств, локальное сохранение и возобновляемая доставка" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Проверить устройства" Style="{StaticResource SecondaryButtonStyle}" Click="CheckDevicesButton_Click" />
            </Grid>

            <Grid x:Name="RecordingHeroGrid" ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <StackPanel x:Name="RecordingMainColumn" Spacing="{StaticResource PageGap}">
                    <Border x:Name="RecordingHeroCard" Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource HeroBorderBrush}" Padding="24">
                        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="RecordingStateBadge" Style="{StaticResource StatusBadgeStyle}">
                                    <TextBlock x:Name="RecordingStateBadgeText" Text="{Binding StateTitle}" FontSize="{StaticResource CaptionTextSize}" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="СОСТОЯНИЕ ЗАПИСИ" Style="{StaticResource EyebrowStyle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding Title, Mode=TwoWay}" Style="{StaticResource InputStyle}" PlaceholderText="Название встречи" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
                                <Ellipse x:Name="StateIndicator" Width="14" Height="14" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StateTitle}" FontSize="{StaticResource HeroTitleSize}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MediaTimeLabel}" FontSize="{StaticResource HeroTitleSize}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="18">
                                <StackPanel>
                                    <TextBlock Text="{Binding MicrophoneStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding MicrophoneLevel}" Minimum="0" Maximum="100" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding MicrophoneDbLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding SystemAudioStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding SystemAudioLevel}" Minimum="0" Maximum="100" Margin="0,6,0,2" />
                                    <TextBlock Text="{Binding SystemAudioDbLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <InfoBar x:Name="ErrorInfoBar" IsOpen="False" IsClosable="False" Severity="Error">
                        <InfoBar.ActionButton>
                            <Button Content="Повторить отправку" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanRetryUpload}" Click="RetryUploadButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <InfoBar x:Name="WarningInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" />

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Жизненный цикл записи" Style="{StaticResource SectionTitleStyle}" />
                            <Grid x:Name="LifeCycleGrid" ColumnDefinitions="*,*,*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                                <TextBlock Text="1 · Проверка" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="2 · Локальное сохранение" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="3 · Master-файл" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="4 · Синхронизация" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="4" Text="5 · API" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="WhisperX обработка" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="ASR → alignment → diarization → готовая стенограмма" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding ProcessingStatus}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" HorizontalTextAlignment="Right" />
                            </Grid>
                            <ProgressBar Value="{Binding ProcessingProgress}" IsIndeterminate="{Binding IsProcessing}" Minimum="0" Maximum="100" />
                            <TextBlock Text="{Binding TranscriptStatus}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ProcessingError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TranscriptPreview}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxLines="3" />
                            <ListView ItemsSource="{Binding TranscriptSegments}" SelectionMode="None" MaxHeight="220">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Padding="0,4">
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Speaker}" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Открыть стенограмму совещания" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenTranscript}" Click="OpenTranscriptButton_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="RecordingSourcesColumn" Grid.Column="1" Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel x:Name="RecordingActionsPanel" Spacing="10">
                            <TextBlock Text="Управление записью" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Следующее доступное действие определяется состоянием Agent." Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" />
                            <Button Content="Начать запись" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanStart}" Click="StartButton_Click" />
                            <Button x:Name="PauseResumeButton" Content="Пауза" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanPause}" Click="PauseResumeButton_Click" />
                            <Button Content="Метка" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanMark}" Click="MarkerButton_Click" />
                            <Button Content="Решение" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanMark}" Click="DecisionButton_Click" />
                            <Button Content="Задача" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanMark}" Click="TaskButton_Click" />
                            <Button Content="Завершить" Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding CanStop}" Click="StopButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Источники записи" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Микрофон" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <ComboBox x:Name="MicrophoneCombo" Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding Microphones}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectDevices}" SelectionChanged="MicrophoneCombo_SelectionChanged" />
                            <TextBlock Text="Системный звук" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
                            <ComboBox x:Name="SystemAudioCombo" Style="{StaticResource FormComboBoxStyle}" ItemsSource="{Binding SystemAudioDevices}" DisplayMemberPath="DisplayName" IsEnabled="{Binding CanSelectDevices}" SelectionChanged="SystemAudioCombo_SelectionChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Локальный архив" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Постоянная копия записи не удаляется после отправки." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ArchiveRoot}" TextWrapping="Wrap" FontSize="{StaticResource CaptionTextSize}" />
                            <Button Content="Выбрать папку архива" Style="{StaticResource CardButtonStyle}" Click="SelectArchiveButton_Click" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SyncCard" Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Синхронизация" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Запись сначала остаётся в локальном архиве. Agent повторяет доставку при восстановлении связи." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding PendingUploadsLabel}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding EncoderBacklogLabel}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            <Button x:Name="RetryUploadPanelButton" Content="Повторить отправку" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding CanRetryUpload}" Click="RetryUploadButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
