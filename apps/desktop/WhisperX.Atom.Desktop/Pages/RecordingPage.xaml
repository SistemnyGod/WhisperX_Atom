<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.RecordingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhisperX_Atom_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <controls:PageHeader Title="Запись" Subtitle="Микрофон → локальный файл → стенограмма">
                <controls:PageHeader.Actions>
                    <Button Content="Проверить устройства" Style="{StaticResource ToolbarButtonStyle}" Click="CheckDevicesButton_Click" AutomationProperties.Name="Проверить устройства записи" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <Border x:Name="RecordingHeroCard" Style="{StaticResource CardStyle}" Padding="24,22">
                <StackPanel Spacing="20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Управление записью" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Выберите источник, задайте название и начинайте запись. Аудио сначала сохраняется локально." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="RecordingStateBadge" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Top">
                            <TextBlock x:Name="RecordingStateBadgeText" Text="{Binding StateTitle}" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                        </Border>
                    </Grid>

                    <StackPanel x:Name="IdleSetupPanel" Spacing="16">
                        <Grid x:Name="IdleSetupGrid" ColumnDefinitions="1.05*,1.35*" ColumnSpacing="16">
                            <Border x:Name="SourceSetupCard" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                <StackPanel Spacing="13">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Параметры встречи" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Эти данные можно изменить до начала записи." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Название совещания" Style="{StaticResource WorkspaceLabelStyle}" />
                                        <TextBox Text="{Binding Title, Mode=TwoWay}" Style="{StaticResource InputStyle}" PlaceholderText="Например, Ежедневная оперативка" AutomationProperties.Name="Название совещания" />
                                    </StackPanel>
                                    <controls:DeviceSelector x:Name="MicrophoneSelector" ItemsSource="{Binding Microphones}" DisplayMemberPath="DisplayName" IsSelectionEnabled="{Binding CanSelectDevices}" Label="Микрофон" HelperText="Записывается именно выбранное устройство." SelectionChanged="MicrophoneCombo_SelectionChanged" />
                                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="10,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8D7;" Foreground="{StaticResource AccentBrush}" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="Можно работать без подключения к серверу" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="SignalPreviewCard" Grid.Column="1" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="Проверка сигнала" Style="{StaticResource SectionTitleStyle}" />
                                            <TextBlock Text="Говорите в микрофон — уровень появится здесь до старта." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}" VerticalAlignment="Top">
                                            <TextBlock Text="ГОТОВ К ЗАПИСИ" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                    </Grid>
                                    <controls:AudioLevelMeter Label="Уровень сигнала" Level="{Binding MicrophoneLevel}" DbText="{Binding MicrophoneDbLabel}" />
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <controls:AudioWaveformMonitor Samples="{Binding MicrophoneWaveform}" SignalState="{Binding MicrophoneSignalState}" IsStale="{Binding MicrophoneTelemetryStale}" Height="96" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding MicrophoneSignalLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding EffectiveMicrophoneLabel}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="{StaticResource CaptionTextSize}" TextWrapping="Wrap" HorizontalTextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Background="{StaticResource SurfaceGreenBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="7" Padding="11,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE73E;" Foreground="{StaticResource SuccessBrush}" />
                                    <TextBlock Text="Локальное хранилище готово" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="7" Padding="11,9">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D7;" Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Сеть необязательна для записи" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Button x:Name="StartButton" Content="Начать запись" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanAttemptStart}" Click="StartButton_Click" AutomationProperties.Name="Начать запись" ToolTipService.ToolTip="Запустить локальную запись" HorizontalAlignment="Stretch" MinHeight="50" FontSize="15" />
                        <TextBlock Text="Запись не останавливается по таймеру. Завершите её кнопкой «Остановить запись» или голосовой командой." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StartReadinessMessage}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ActiveRecordingPanel" Visibility="Collapsed" Spacing="{StaticResource SectionGap}">
                        <Border Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18">
                            <Grid ColumnDefinitions="1.55*,*" ColumnSpacing="20">
                                <StackPanel Grid.Column="0" Spacing="16">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ЖИВАЯ ЗАПИСЬ" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Ellipse x:Name="StateIndicator" Width="10" Height="10" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StateTitle}" FontSize="{StaticResource BodyTextSize}" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,7" VerticalAlignment="Top">
                                            <TextBlock Text="ЛОКАЛЬНО" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding MediaTimeLabel}" FontSize="48" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalTextAlignment="Center" />
                                    <TextBlock Text="{Binding EffectiveMicrophoneLabel}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalTextAlignment="Center" />
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <controls:AudioWaveformMonitor Samples="{Binding MicrophoneWaveform}" SignalState="{Binding MicrophoneSignalState}" IsStale="{Binding MicrophoneTelemetryStale}" Height="122" />
                                    </Border>
                                    <controls:AudioLevelMeter Label="Уровень сигнала" Level="{Binding MicrophoneLevel}" DbText="{Binding MicrophoneDbLabel}" />
                                    <TextBlock Text="{Binding MicrophoneSignalLabel}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalTextAlignment="Center" />
                                    <StackPanel x:Name="RecordingActionsPanel" Orientation="Horizontal" Spacing="10">
                                        <Button x:Name="PauseResumeButton" Content="Пауза" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanPause}" Click="PauseResumeButton_Click" AutomationProperties.Name="Пауза записи" MinHeight="48" HorizontalAlignment="Stretch" />
                                        <Button Content="Завершить" Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding CanStop}" Click="StopButton_Click" AutomationProperties.Name="Завершить запись" ToolTipService.ToolTip="Завершить запись и сохранить локальный файл" MinHeight="48" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                        <Button Content="Метка" Style="{StaticResource GhostButtonStyle}" IsEnabled="{Binding CanMark}" Click="MarkerButton_Click" AutomationProperties.Name="Добавить метку" />
                                        <Button Content="Решение" Style="{StaticResource GhostButtonStyle}" IsEnabled="{Binding CanMark}" Click="DecisionButton_Click" AutomationProperties.Name="Добавить решение" />
                                        <Button Content="Задача" Style="{StaticResource GhostButtonStyle}" IsEnabled="{Binding CanMark}" Click="TaskButton_Click" AutomationProperties.Name="Добавить задачу" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="12">
                                    <TextBlock Text="Состояние записи" Style="{StaticResource SectionTitleStyle}" />
                                    <Border Background="{StaticResource SurfaceGreenBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Локальное сохранение" FontWeight="SemiBold" />
                                            <TextBlock Text="Аудио пишется на диск" Style="{StaticResource CaptionStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Архив" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ArchiveStatusLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceOrangeBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Доставка" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding DeliveryStatusLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="WhisperX" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ProcessingStatus}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="Мифодий слушает" FontWeight="SemiBold" />
                                            <TextBlock Text="Голосовые команды доступны во время записи" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="FinalizingPanel" Visibility="Collapsed" Spacing="{StaticResource CardGap}">
                        <Border x:Name="FinalizeOutcomeSurface" Background="{StaticResource SurfaceGreenBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon x:Name="FinalizeOutcomeIcon" Glyph="&#xE73E;" Foreground="{StaticResource SuccessBrush}" />
                                <TextBlock x:Name="FinalizeOutcomeText" Text="{Binding LocalFinalizeStatusLabel}" FontSize="{StaticResource BodyTextSize}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                            <TextBlock Text="Локальное сохранение" />
                            <TextBlock Grid.Column="1" Text="{Binding LocalFinalizeStatusLabel}" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Grid.Row="1" Text="Кодирование аудио" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EncodingStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="2" Text="Отправка на сервер" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DeliveryStatusLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Row="3" Text="Обработка WhisperX" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProcessingStatus}" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                        <ProgressBar Value="{Binding ProcessingProgress}" IsIndeterminate="{Binding IsProcessing}" Minimum="0" Maximum="100" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Content="Начать новую запись" Style="{StaticResource PrimaryButtonStyle}" Click="StartButton_Click" IsEnabled="{Binding CanAttemptStart}" />
                            <Button Grid.Column="1" Content="Открыть совещание" Style="{StaticResource SecondaryButtonStyle}" Click="OpenTranscriptButton_Click" IsEnabled="{Binding CanOpenTranscript}" />
                        </Grid>
                    </StackPanel>

                    <InfoBar x:Name="ErrorInfoBar" IsOpen="False" IsClosable="False" Severity="Error">
                        <InfoBar.ActionButton>
                            <Button x:Name="RetryUploadInfoButton" Content="Повторить отправку" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanRetryUpload}" Click="RetryUploadButton_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="WarningInfoBar" IsOpen="False" IsClosable="False" Severity="Warning" />
                </StackPanel>
            </Border>

            <StackPanel x:Name="ProcessingPanel" Visibility="Collapsed" Spacing="{StaticResource PageGap}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="{StaticResource CardGap}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Стенограмма" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Transcript V1 доступна сразу после ASR; дополнительная разметка выполняется отдельно." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding TranscriptStatus}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <controls:ProcessingStepper Steps="{Binding ProcessingSteps}" CurrentIndex="{Binding ProcessingStageIndex}" />
                        <ProgressBar Value="{Binding ProcessingProgress}" IsIndeterminate="{Binding IsProcessing}" Minimum="0" Maximum="100" />
                        <TextBlock Text="{Binding TranscriptPreview}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxLines="4" />
                        <TextBlock Text="{Binding ProcessingError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        <Button Content="Открыть предварительную стенограмму" Style="{StaticResource SecondaryButtonStyle}" IsEnabled="{Binding CanOpenTranscript}" Click="OpenTranscriptButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Expander x:Name="DetailsExpander" Header="Подробности сохранения и доставки" IsExpanded="False">
                <StackPanel Spacing="{StaticResource CardGap}" Padding="0,10,0,0">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Чанки и кодирование" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding ChunkSyncLabel}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding PendingBytesLabel}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding EncoderBacklogLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding RawPipelineLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Доставка" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{Binding DeliveryStatusLabel}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding DeliveryDiagnosticLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DeliveryTraceLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <Button Content="Повторить отправку" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding CanRetryUpload}" Click="RetryUploadButton_Click" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                    <Border x:Name="SyncCard" Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding RecorderRecoveryLabel}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding StorageWatermarkLabel}" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{Binding ArchiveStatusLabel}" Style="{StaticResource CaptionStyle}" />
                </StackPanel>
            </Expander>

            <Expander Header="Дополнительные настройки источника" IsExpanded="False">
                <StackPanel Spacing="{StaticResource CardGap}" Padding="0,10,0,0">
                    <TextBlock Text="Профиль записи" Style="{StaticResource WorkspaceLabelStyle}" />
                    <ComboBox x:Name="RecordingProfileSelector" ItemsSource="{Binding RecordingProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding RecordingProfile, Mode=OneWay}" IsEnabled="{Binding CanSelectRecordingProfile}" SelectionChanged="RecordingProfile_SelectionChanged" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Профиль записи" />
                    <TextBlock Text="Акустика кабинета" Style="{StaticResource WorkspaceLabelStyle}" />
                    <ComboBox x:Name="AcousticProfileSelector" ItemsSource="{Binding AcousticProfiles}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding AcousticProfile, Mode=OneWay}" IsEnabled="{Binding CanSelectDevices}" SelectionChanged="AcousticProfile_SelectionChanged" Style="{StaticResource FormComboBoxStyle}" AutomationProperties.Name="Акустический профиль" />
                    <TextBlock Text="Авто выберет усиление для дальнего микрофона; исходная запись не изменяется." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Для большой комнаты и 8+ участников рекомендуется USB-конференц-микрофон в центре стола. Усиление улучшает распознавание, но не заменяет физический охват микрофона." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Проверка кабинета · 10 секунд" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="Скажите короткую фразу сначала у микрофона, затем с дальнего места. Проверка не запускает запись и не отправляет аудио." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <Button Content="Проверить акустику кабинета" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding CanRunRoomAcousticCheck}" Click="RoomAcousticCheckButton_Click" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding RoomAcousticCheckStatus}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Системный звук" Style="{StaticResource SectionTitleStyle}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Системный звук недоступен в текущей версии и не занимает основной экран." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="ПОЗЖЕ" Style="{StaticResource CaptionStyle}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                    </Grid>
                    <controls:DeviceSelector x:Name="SystemAudioSelector" ItemsSource="{Binding SystemAudioDevices}" DisplayMemberPath="DisplayName" IsSelectionEnabled="{Binding SystemAudioCaptureAvailable}" Label="Системный звук" HelperText="Доступен только в legacy-режиме." SelectionChanged="SystemAudioCombo_SelectionChanged" />
                    <Button Content="Проверить системный звук" Style="{StaticResource CardButtonStyle}" IsEnabled="{Binding SystemAudioCaptureAvailable}" Click="TestSystemAudioButton_Click" />
                    <TextBlock Text="{Binding SystemAudioTestStatus}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
