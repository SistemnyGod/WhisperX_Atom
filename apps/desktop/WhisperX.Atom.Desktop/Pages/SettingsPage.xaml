<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhisperX_Atom_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <controls:PageHeader Title="Настройки" Subtitle="Подключение, запись и локальное хранение">
                <controls:PageHeader.Actions>
                    <Button x:Name="OpenSetupWizardButton" Content="Повторить настройку" Style="{StaticResource ToolbarButtonStyle}" Click="OpenSetupWizardButton_Click" AutomationProperties.Name="Повторить мастер настройки" ToolTipService.ToolTip="Проверить основные компоненты по шагам" />
                </controls:PageHeader.Actions>
            </controls:PageHeader>
            <Border x:Name="UserSettingsCard" Style="{StaticResource CardStyle}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Основные настройки" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Для записи достаточно выбрать микрофон и папку архива. Технические данные находятся ниже." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Открыть запись" Style="{StaticResource SecondaryButtonStyle}" Click="OpenRecordingButton_Click" AutomationProperties.Name="Открыть настройки записи" />
                </Grid>
            </Border>
            <Grid x:Name="SettingsLayoutGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border x:Name="ApiSettingsCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Подключение к API" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Сервер" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox x:Name="ApiUrlBox" Text="{Binding ApiUrl, Mode=TwoWay}" IsReadOnly="{Binding ServerOriginManaged}" Style="{StaticResource InputStyle}" />
                        <TextBlock Text="Текущий пользователь" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Text="{Binding Username, Mode=TwoWay}" IsReadOnly="True" Style="{StaticResource InputStyle}" />
                        <TextBlock x:Name="LoginHintText" Text="Для входа используйте окно авторизации приложения." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="PasswordFieldsPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="PasswordLabel" Text="Текущий пароль для смены" Foreground="{StaticResource MutedTextBrush}" />
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInputStyle}" PlaceholderText="Текущий пароль" />
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordInputStyle}" PlaceholderText="Новый пароль (минимум 12 символов)" />
                        </StackPanel>
                        <StackPanel x:Name="ApiActionsPanel" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChangePasswordButton" Content="Сменить пароль" Style="{StaticResource SecondaryButtonStyle}" Click="ChangePasswordButton_Click" IsEnabled="{Binding CanChangePassword}" />
                            <Button Content="Применить адрес сервера" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyServerOriginButton_Click" IsEnabled="{Binding CanChangeServerOrigin}" AutomationProperties.Name="Применить адрес сервера" />
                            <Button Content="Проверить API" Style="{StaticResource SecondaryButtonStyle}" Click="CheckBackendButton_Click" IsEnabled="{Binding CanUseActions}" AutomationProperties.Name="Проверить API" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="AgentSettingsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Recorder Agent" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="После входа Agent привязывается к пользователю автоматически." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Состояние подключения" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LoginStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SessionExpiryText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ProgressRing Grid.Column="1" Width="22" Height="22" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Expander Header="Техническая диагностика Recorder Host" IsExpanded="False">
                            <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding RecorderRuntimeState}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding RecorderRuntimeOrigin}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RecorderRuntimeBuild}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RecorderRuntimeProcess}" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding RecorderRuntimeIdentity}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RecorderRuntimePath}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding RecorderRuntimeError}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Expander>
                        <TextBlock Text="Имя Agent" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Text="{Binding AgentName, Mode=TwoWay}" Style="{StaticResource InputStyle}" />
                        <TextBlock Text="Действия" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <Button Content="Подключить или восстановить Agent" Style="{StaticResource PrimaryButtonStyle}" Click="ReconnectAgentButton_Click" IsEnabled="{Binding CanReconnectAgent}" AutomationProperties.Name="Подключить или восстановить Recorder Agent" ToolTipService.ToolTip="Проверить локальный сервис и восстановить привязку Agent" />
                        <Button Content="Запустить Recorder Service" Style="{StaticResource SecondaryButtonStyle}" Click="StartRecorderButton_Click" IsEnabled="{Binding CanUseActions}" AutomationProperties.Name="Запустить Recorder Service" ToolTipService.ToolTip="Запустить локальный сервис записи" />
                        <Button Content="Сохранить диагностику" Style="{StaticResource SecondaryButtonStyle}" Click="SaveDiagnosticsButton_Click" IsEnabled="{Binding CanUseActions}" AutomationProperties.Name="Сохранить диагностику подключения" ToolTipService.ToolTip="Сохранить технические статусы без аудио, токенов и стенограмм" />
                        <Button Content="Выйти из API" Style="{StaticResource SecondaryButtonStyle}" Click="LogoutButton_Click" IsEnabled="{Binding CanLogout}" AutomationProperties.Name="Выйти из API" />
                    </StackPanel>
                </Border>
            </Grid>
            <Expander Header="Экспериментальные функции · Мифодий" IsExpanded="True">
                <Border x:Name="MifodiyDiagnosticsCard" Style="{StaticResource CardStyle}" Padding="20">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Проверка Мифодия" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Локальное распознавание команд без сохранения аудио ожидания" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="MifodiyStatusBadge" Grid.Column="1" Background="{StaticResource SurfaceGreenBrush}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="1" CornerRadius="16" Padding="12,7" VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse x:Name="MifodiyStatusDot" Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="MifodiyStatusText" Text="{Binding VoiceStatus}" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="20">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Состояние Voice Host" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding VoiceStatus}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Wake word: Мифодий · Мефодий · Атом" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Всегда слушать" Style="{StaticResource CaptionStyle}" />
                                    <ToggleSwitch IsOn="{Binding VoiceAlwaysListening, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" AutomationProperties.Name="Всегда слушать Мифодия" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="Тихий режим" Style="{StaticResource CaptionStyle}" />
                                    <ToggleSwitch IsOn="{Binding VoiceQuietMode, Mode=TwoWay}" OnContent="Вкл" OffContent="Выкл" AutomationProperties.Name="Тихий режим Мифодия" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Style="{StaticResource CardStyle}" Padding="14" Background="{StaticResource SurfaceBlueBrush}">
                                <StackPanel Spacing="9">
                                    <TextBlock Text="Микрофон и сигнал" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Фактически используемое устройство" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding VoiceMicrophone}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Запрошенный endpoint" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding VoiceRequestedMicrophone}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="NAudio endpoint" Style="{StaticResource CaptionStyle}" />
                                            <TextBlock Text="{Binding VoiceEffectiveMicrophone}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Живой уровень сигнала" Style="{StaticResource CaptionStyle}" />
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                        <Grid x:Name="VoiceBarsPanel" Height="58" ColumnSpacing="3" HorizontalAlignment="Stretch" />
                                    </Border>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <TextBlock Text="{Binding VoiceSignalState}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding VoiceLevel}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="До кодового слова аудио сразу удаляется и не попадает в стенограмму." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Компоненты" Style="{StaticResource SectionTitleStyle}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Vosk / модель" />
                                        <TextBlock Grid.Column="1" Text="{Binding VoiceWakeWordMode}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Recorder Broker" />
                                        <TextBlock Grid.Column="1" Text="{Binding VoiceRuntimeProcess}" Foreground="{StaticResource SuccessBrush}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Text="Сборка Voice Host" />
                                        <TextBlock Grid.Column="1" Text="{Binding VoiceRuntimeBuild}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                                    </Grid>
                                    <TextBlock Text="Путь Voice Host" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding VoiceRuntimePath}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="Ожидаемая / наблюдаемая сборка" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding VoiceExpectedBuild}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceObservedBuild}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Перезапуски:" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding VoiceRestartCount}" Style="{StaticResource CaptionStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="Код ошибки" Style="{StaticResource CaptionStyle}" />
                                    <TextBlock Text="{Binding VoiceErrorCode}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding VoiceDiagnosticsDetail}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource SurfaceBlueBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Тест команды (без запуска записи)" Style="{StaticResource SectionTitleStyle}" />
                                        <TextBlock Text="Проверяет Vosk, intent и confidence. Recorder Host не вызывается." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="testMode=true" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <TextBlock Text="Мифодий, начни запись" FontSize="15" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Начать тест" Style="{StaticResource PrimaryButtonStyle}" Click="TestVoiceSpeechButton_Click" />
                                    <Button Content="Проверить TTS" Style="{StaticResource SecondaryButtonStyle}" Click="TestVoiceTtsButton_Click" />
                                    <Button Content="Обновить статус" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshVoiceButton_Click" />
                                </StackPanel>
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="Последнее распознавание" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding VoiceLastRecognition}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Последняя команда" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding VoiceLastCommandId}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Trace ID" Style="{StaticResource CaptionStyle}" />
                                        <TextBlock Text="{Binding VoiceLastTraceId}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <Border Style="{StaticResource CardStyle}" Padding="14">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Чувствительность" Style="{StaticResource SectionTitleStyle}" />
                                    <ComboBox SelectedValue="{Binding VoiceSensitivity, Mode=TwoWay}" SelectedValuePath="Tag" PlaceholderText="Выберите чувствительность" AutomationProperties.Name="Чувствительность распознавания Мифодия">
                                        <ComboBoxItem Tag="low" Content="Низкая" />
                                        <ComboBoxItem Tag="balanced" Content="Сбалансированная" />
                                        <ComboBoxItem Tag="high" Content="Высокая" />
                                    </ComboBox>
                                    <TextBlock Text="Обычные команды исполняются только после кодового слова." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                    <TextBlock Text="Голос ответа" Style="{StaticResource CaptionStyle}" Margin="0,6,0,0" />
                                    <TextBox Text="{Binding VoiceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Microsoft Irina" Style="{StaticResource InputStyle}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="Скорость" Style="{StaticResource CaptionStyle}" />
                                            <NumberBox Value="{Binding VoiceRate, Mode=TwoWay}" Minimum="-10" Maximum="10" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="Громкость, %" Style="{StaticResource CaptionStyle}" />
                                            <NumberBox Value="{Binding VoiceVolume, Mode=TwoWay}" Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Используется только установленный русский голос; при отсутствии ru-RU TTS отключается." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource SurfaceOrangeBrush}" BorderBrush="{StaticResource WarningBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Последнее событие" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding VoiceLastRecognition}" TextWrapping="Wrap" />
                                    <TextBlock Text="Тестовый режим не меняет состояние записи." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Запись и архив" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Локальный master-файл сохраняется в архиве независимо от серверной доставки." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <Grid x:Name="ArchivePathGrid" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding ArchiveRoot}" IsReadOnly="True" Style="{StaticResource InputStyle}" />
                        <Button x:Name="SelectArchiveButton" Grid.Column="1" Content="Выбрать" Style="{StaticResource SecondaryButtonStyle}" Click="SelectArchiveButton_Click" IsEnabled="{Binding CanUseActions}" />
                        <Button x:Name="OpenArchiveButton" Grid.Column="2" Content="Открыть" Style="{StaticResource SecondaryButtonStyle}" Click="OpenArchiveButton_Click" IsEnabled="{Binding CanUseActions}" />
                    </Grid>
                </StackPanel>
            </Border>
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
