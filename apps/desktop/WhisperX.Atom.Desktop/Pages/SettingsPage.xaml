<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WhisperX_Atom_Desktop.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WhisperX_Atom_Desktop.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource PagePadding}" Spacing="{StaticResource PageGap}">
            <controls:PageHeader Title="Настройки" Subtitle="Подключение к API, Recorder Agent и локальный архив" />
            <Grid x:Name="SettingsLayoutGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                <Border x:Name="ApiSettingsCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Подключение к API" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="Сервер" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox x:Name="ApiUrlBox" Text="{Binding ApiUrl, Mode=TwoWay}" IsReadOnly="{Binding ServerOriginManaged}" Style="{StaticResource InputStyle}" />
                        <TextBlock Text="Текущий пользователь" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Text="{Binding Username, Mode=TwoWay}" IsReadOnly="True" Style="{StaticResource InputStyle}" />
                        <TextBlock x:Name="LoginHintText" Text="Для входа используйте окно авторизации приложения." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <StackPanel x:Name="PasswordFieldsPanel" Spacing="10" Visibility="Collapsed">
                            <TextBlock x:Name="PasswordLabel" Text="Текущий пароль для смены" Foreground="{StaticResource MutedTextBrush}" />
                            <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInputStyle}" PlaceholderText="Текущий пароль" />
                            <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordInputStyle}" PlaceholderText="Новый пароль (минимум 12 символов)" />
                        </StackPanel>
                        <StackPanel x:Name="ApiActionsPanel" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChangePasswordButton" Content="Сменить пароль" Style="{StaticResource SecondaryButtonStyle}" Click="ChangePasswordButton_Click" IsEnabled="{Binding CanChangePassword}" />
                            <Button Content="Применить адрес сервера" Style="{StaticResource SecondaryButtonStyle}" Click="ApplyServerOriginButton_Click" IsEnabled="{Binding CanChangeServerOrigin}" AutomationProperties.Name="Применить адрес сервера" />
                            <Button Content="Проверить API" Style="{StaticResource SecondaryButtonStyle}" Click="CheckBackendButton_Click" IsEnabled="{Binding CanUseActions}" AutomationProperties.Name="Проверить API" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="AgentSettingsCard" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Recorder Agent" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="После входа Agent привязывается к пользователю автоматически." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Состояние подключения" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding LoginStatusText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding SessionExpiryText}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ProgressRing Grid.Column="1" Width="22" Height="22" IsActive="{Binding IsBusy}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                            <StackPanel Spacing="3">
                                <TextBlock Text="Диагностика Recorder Host" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RecorderRuntimeState}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding RecorderRuntimeOrigin}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecorderRuntimeBuild}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecorderRuntimeProcess}" Style="{StaticResource CaptionStyle}" />
                                <TextBlock Text="{Binding RecorderRuntimeIdentity}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecorderRuntimePath}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding RecorderRuntimeError}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Имя Agent" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBox Text="{Binding AgentName, Mode=TwoWay}" Style="{StaticResource InputStyle}" />
                        <TextBlock Text="Действия" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                        <Button Content="Подключить или восстановить Agent" Style="{StaticResource PrimaryButtonStyle}" Click="ReconnectAgentButton_Click" IsEnabled="{Binding CanReconnectAgent}" AutomationProperties.Name="Подключить или восстановить Recorder Agent" ToolTipService.ToolTip="Проверить локальный сервис и восстановить привязку Agent" />
                        <Button Content="Запустить Recorder Service" Style="{StaticResource SecondaryButtonStyle}" Click="StartRecorderButton_Click" IsEnabled="{Binding CanUseActions}" AutomationProperties.Name="Запустить Recorder Service" ToolTipService.ToolTip="Запустить локальный сервис записи" />
                        <Button Content="Сохранить диагностику" Style="{StaticResource SecondaryButtonStyle}" Click="SaveDiagnosticsButton_Click" IsEnabled="{Binding CanUseActions}" AutomationProperties.Name="Сохранить диагностику подключения" ToolTipService.ToolTip="Сохранить технические статусы без аудио, токенов и стенограмм" />
                        <Button Content="Выйти из API" Style="{StaticResource SecondaryButtonStyle}" Click="LogoutButton_Click" IsEnabled="{Binding CanLogout}" AutomationProperties.Name="Выйти из API" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Проверка Мифодия" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Локальное распознавание кодового слова и команд. В тестовом режиме запись не запускается." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <StackPanel Spacing="8">
                            <CheckBox Content="Всегда слушать" IsChecked="{Binding VoiceAlwaysListening, Mode=TwoWay}" />
                            <CheckBox Content="Тихий режим (без голоса)" IsChecked="{Binding VoiceQuietMode, Mode=TwoWay}" />
                            <ComboBox SelectedValue="{Binding VoiceSensitivity, Mode=TwoWay}" SelectedValuePath="Tag" PlaceholderText="Чувствительность">
                                <ComboBoxItem Tag="low" Content="Низкая" />
                                <ComboBoxItem Tag="balanced" Content="Сбалансированная" />
                                <ComboBoxItem Tag="high" Content="Высокая" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Состояние" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding VoiceStatus}" TextWrapping="Wrap" />
                            <TextBlock Text="Режим wake word" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceWakeWordMode}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="Сборка Voice Host" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceRuntimeBuild}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="Процесс" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceRuntimeProcess}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="Последний trace ID" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceLastTraceId}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="Последнее распознавание" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceLastRecognition}" TextWrapping="Wrap" />
                            <TextBlock Text="Микрофон" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceMicrophone}" TextWrapping="Wrap" />
                            <TextBlock Text="Живой уровень" Style="{StaticResource CaptionStyle}" />
                            <Grid x:Name="VoiceBarsPanel" Height="58" ColumnSpacing="3" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding VoiceSignalState}" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceLevel}" />
                            <TextBlock Text="Код ошибки" Style="{StaticResource CaptionStyle}" />
                            <TextBlock Text="{Binding VoiceErrorCode}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Проверить фразу" Style="{StaticResource SecondaryButtonStyle}" Click="TestVoiceSpeechButton_Click" />
                        <Button Content="Проверить голос" Style="{StaticResource SecondaryButtonStyle}" Click="TestVoiceTtsButton_Click" />
                        <Button Content="Обновить статус" Style="{StaticResource SecondaryButtonStyle}" Click="RefreshVoiceButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Запись и архив" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Локальный master-файл сохраняется в архиве независимо от серверной доставки." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <Grid x:Name="ArchivePathGrid" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding ArchiveRoot}" IsReadOnly="True" Style="{StaticResource InputStyle}" />
                        <Button x:Name="SelectArchiveButton" Grid.Column="1" Content="Выбрать" Style="{StaticResource SecondaryButtonStyle}" Click="SelectArchiveButton_Click" IsEnabled="{Binding CanUseActions}" />
                        <Button x:Name="OpenArchiveButton" Grid.Column="2" Content="Открыть" Style="{StaticResource SecondaryButtonStyle}" Click="OpenArchiveButton_Click" IsEnabled="{Binding CanUseActions}" />
                    </Grid>
                </StackPanel>
            </Border>
            <InfoBar x:Name="StatusInfoBar" IsOpen="False" IsClosable="False" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
