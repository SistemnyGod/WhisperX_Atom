<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhisperX_Atom_Desktop.Controls.AudioLevelMeter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="5">
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{x:Bind Label, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource CaptionTextSize}" />
            <TextBlock Grid.Column="1" Text="{x:Bind DbText, Mode=OneWay}" Style="{StaticResource TableCellStyle}" FontSize="{StaticResource CaptionTextSize}" />
        </Grid>
        <Border Background="{StaticResource DisabledSurfaceBrush}" CornerRadius="5" Padding="0,1">
            <ProgressBar Value="{x:Bind Level, Mode=OneWay}" Minimum="0" Maximum="100" Height="9" Background="Transparent" Foreground="{StaticResource AccentBrush}" AutomationProperties.Name="Уровень сигнала" />
        </Border>
    </StackPanel>
</UserControl>
