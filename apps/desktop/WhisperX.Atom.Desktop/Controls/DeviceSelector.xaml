<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhisperX_Atom_Desktop.Controls.DeviceSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="5">
        <TextBlock Text="{x:Bind Label, Mode=OneWay}" Style="{StaticResource WorkspaceLabelStyle}" />
        <ComboBox x:Name="Selector"
                  ItemsSource="{x:Bind ItemsSource, Mode=OneWay}"
                  SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
                  DisplayMemberPath="{x:Bind DisplayMemberPath, Mode=OneWay}"
                  IsEnabled="{x:Bind IsSelectionEnabled, Mode=OneWay}"
                  Style="{StaticResource FormComboBoxStyle}"
                  AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                  ToolTipService.ToolTip="{x:Bind HelperText, Mode=OneWay}" />
        <TextBlock Text="{x:Bind HelperText, Mode=OneWay}" Style="{StaticResource CaptionStyle}" />
    </StackPanel>
</UserControl>
