<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhisperX_Atom_Desktop.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" Style="{StaticResource StatusBadgeStyle}" HorizontalAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse x:Name="Indicator" Width="7" Height="7" VerticalAlignment="Center" />
            <TextBlock x:Name="BadgeText" Text="{x:Bind Text, Mode=OneWay}" FontSize="{StaticResource CaptionTextSize}" FontWeight="SemiBold" />
        </StackPanel>
    </Border>
</UserControl>
