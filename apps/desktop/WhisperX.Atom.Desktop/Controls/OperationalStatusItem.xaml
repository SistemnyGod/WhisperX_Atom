<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhisperX_Atom_Desktop.Controls.OperationalStatusItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" MinHeight="56">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
            <Ellipse x:Name="Indicator" Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,0,0" Fill="{StaticResource NeutralStatusBrush}" />
            <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Bind Title, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxLines="2" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" HorizontalTextAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind Status, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
