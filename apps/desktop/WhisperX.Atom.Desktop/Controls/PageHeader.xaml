<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhisperX_Atom_Desktop.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" SizeChanged="RootGrid_SizeChanged">
        <TextBlock x:Name="TitleText" Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource PageTitleStyle}" />
        <ContentPresenter x:Name="ActionsPresenter" Grid.Column="1" Content="{x:Bind Actions, Mode=OneWay}" VerticalAlignment="Center" />
        <TextBlock x:Name="SubtitleText" Grid.Row="1" Text="{x:Bind Subtitle, Mode=OneWay}" Foreground="{StaticResource MutedTextBrush}" FontSize="{StaticResource BodyTextSize}" TextWrapping="Wrap" Margin="0,4,0,0" />
    </Grid>
</UserControl>
