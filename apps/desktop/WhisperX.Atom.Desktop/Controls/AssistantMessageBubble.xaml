<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WhisperX_Atom_Desktop.Controls.AssistantMessageBubble"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid" HorizontalAlignment="Stretch">
        <Border x:Name="Bubble" MaxWidth="760" Padding="14,11" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock x:Name="RoleText" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock x:Name="ContentText" TextWrapping="Wrap" LineHeight="21" />
                <TextBlock x:Name="MetaText" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
