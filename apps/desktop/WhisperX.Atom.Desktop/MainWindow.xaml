<Window x:Class="WhisperX.Atom.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperX Atom" Width="1280" Height="820" MinWidth="1050" MinHeight="650"
        Background="#10151D" Foreground="#EDF2F7" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,7"/></Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8"/><Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#263447"/><Setter Property="Foreground" Value="#F3F6FA"/>
            <Setter Property="BorderBrush" Value="#3B4A60"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#3B4A60"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#3B4A60"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111923"/><Setter Property="Foreground" Value="#EDF2F7"/>
            <Setter Property="BorderBrush" Value="#3B4A60"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TabItem"><Setter Property="Padding" Value="16,10"/></Style>
        <Style TargetType="ListViewItem"><Setter Property="Padding" Value="4"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="6,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WhisperX Atom" FontSize="30" FontWeight="SemiBold" Foreground="#66D9EF"/>
                <TextBlock Text="Единое Desktop-приложение записи и обработки совещаний" Foreground="#9AA8BA"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="Агент:" Foreground="#9AA8BA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock x:Name="AgentStatusText" Text="Проверка" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBlock Text="    API:" Foreground="#9AA8BA" VerticalAlignment="Center"/>
                <TextBlock x:Name="ServerStatusText" Text="Проверка" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
        <TabControl Grid.Row="1" Background="#151D28" BorderBrush="#2A394D">
            <TabItem Header="Запись">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="18" Background="#182333" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Состояние записи" Foreground="#9AA8BA"/>
                            <TextBlock x:Name="RecordingStateText" Text="Ожидание" FontSize="28" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SessionText" Text="Сессия не создана" Foreground="#9AA8BA"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,18,0,8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Название записи" VerticalAlignment="Center" Foreground="#9AA8BA" Margin="0,0,12,0"/>
                            <TextBox x:Name="RecordingTitleBox" Width="420" Padding="8" ToolTip="Если совещание не выбрано, оно будет создано автоматически."/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="StartRecordingButton" Content="Начать запись" Click="StartButton_Click" Background="#1D7A58"/>
                            <Button x:Name="PauseRecordingButton" Content="Пауза" Click="PauseButton_Click"/>
                            <Button x:Name="ResumeRecordingButton" Content="Продолжить" Click="ResumeButton_Click"/>
                            <Button x:Name="StopRecordingButton" Content="Завершить" Click="StopButton_Click" Background="#8D3942"/>
                            <Button Content="Обновить" Click="RefreshButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Padding="18" Margin="0,0,10,0" Background="#182333" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Состояние устройств" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MicrophoneText" Text="Микрофон: проверка"/>
                                <TextBlock x:Name="SystemAudioText" Text="Системный звук: проверка"/>
                                <TextBlock x:Name="StorageText" Text="Диск: проверка"/>
                                <TextBlock x:Name="DeviceErrorText" Text="" Foreground="#F6B26B" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" Margin="10,0,0,0" Background="#182333" CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Связь с backend" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="Named pipe: WhisperXAtomAgent" Foreground="#9AA8BA"/>
                                <TextBlock Text="Запись и управление работают локально; сервер нужен для обработки и истории." TextWrapping="Wrap" Foreground="#9AA8BA"/>
                                <TextBlock x:Name="ProcessingStatusText" Text="Обработка: не запущена" Foreground="#66D9EF" TextWrapping="Wrap" Margin="0,12,0,4"/>
                                <ProgressBar x:Name="ProcessingProgressBar" Minimum="0" Maximum="100" Height="8" Visibility="Collapsed"/>
                                <TextBlock x:Name="ProcessingErrorText" Text="" Foreground="#F6B26B" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="LastErrorText" Text="" Foreground="#EF8F8F" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Совещания">
                <Grid Margin="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="История совещаний" FontSize="20" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal"><Button Content="Обновить" Click="LoadMeetingsButton_Click" HorizontalAlignment="Left"/><Button Content="Создать" Click="CreateMeetingButton_Click" HorizontalAlignment="Left" Background="#1D7A58"/><Button x:Name="ImportButton" Content="Импорт файла" Click="ImportFileButton_Click" HorizontalAlignment="Left" Background="#365A8A"/></StackPanel>
                        <TextBlock x:Name="ImportStatusText" Text="Аудио/видео можно импортировать из локальной папки" Foreground="#9AA8BA" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBox x:Name="NewMeetingTitleBox" Padding="8" Margin="0,0,0,8" ToolTip="Название для нового совещания"/>
                        <TextBox x:Name="MeetingSearchBox" Padding="8" Margin="0,0,0,4" ToolTip="Поиск по названию или статусу" TextChanged="MeetingSearchBox_TextChanged"/>
                        <TextBlock x:Name="MeetingCountText" Text="Совещания не загружены" Foreground="#9AA8BA" Margin="0,0,0,6"/>
                        <ListBox x:Name="MeetingsList" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" DisplayMemberPath="Title" SelectionChanged="MeetingsList_SelectionChanged"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="16" Background="#182333" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Выбранное совещание" Foreground="#9AA8BA"/>
                                <TextBlock x:Name="SelectedMeetingTitle" Text="Совещание не выбрано" FontSize="24" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedMeetingStatus" Text="" Foreground="#9AA8BA"/>
                            </StackPanel>
                        </Border>
                        <TabControl Grid.Row="1" Background="#182333">
                            <TabItem Header="Стенограмма">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock x:Name="TranscriptStatusText" Text="Стенограмма ещё не готова" Foreground="#9AA8BA"/>
                                    <ListView x:Name="TranscriptList" Grid.Row="1" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TranscriptList_SelectionChanged">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Foreground="#9AA8BA" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Speaker}" Foreground="#66D9EF" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Плеер">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <MediaElement x:Name="PreviewPlayer" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaFailed="PreviewPlayer_MediaFailed"/>
                                    <Slider x:Name="PositionSlider" Grid.Row="1" Minimum="0" Maximum="1" ValueChanged="PositionSlider_ValueChanged" Margin="0,12,0,8"/>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="Воспроизвести" Click="PlayButton_Click"/><Button Content="Пауза" Click="PlayerPauseButton_Click"/><Button Content="Стоп" Click="PlayerStopButton_Click"/>
                                        <TextBlock x:Name="PlayerStatusText" Text="Плеер не загружен" Foreground="#9AA8BA" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Спикеры">
                                <Grid Margin="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                    <ListView x:Name="SpeakerList" Grid.Column="0" SelectionChanged="SpeakerList_SelectionChanged">
                                        <ListView.View><GridView><GridViewColumn Header="Ключ" Width="150" DisplayMemberBinding="{Binding StableKey}"/><GridViewColumn Header="Имя" Width="240" DisplayMemberBinding="{Binding DisplayName}"/></GridView></ListView.View>
                                    </ListView>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                        <TextBlock Text="Редактирование спикера" FontSize="17" FontWeight="SemiBold"/>
                                        <TextBox x:Name="SpeakerNameBox" Padding="7" Margin="0,0,0,8"/>
                                        <Button Content="Переименовать" Click="RenameSpeakerButton_Click"/>
                                        <Separator Margin="0,12"/>
                                        <TextBlock Text="Объединить два технических кластера" TextWrapping="Wrap"/>
                                        <ComboBox x:Name="MergeSourceBox" DisplayMemberPath="DisplayName" Margin="0,6,0,6"/>
                                        <ComboBox x:Name="MergeTargetBox" DisplayMemberPath="DisplayName" Margin="0,0,0,6"/>
                                        <Button Content="Объединить" Click="MergeSpeakersButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Саммари">
                                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBox x:Name="SummaryTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111923" Foreground="#EDF2F7" BorderBrush="#3B4A60" Padding="12"/>
                                    <Button Grid.Row="1" Content="Пересобрать саммари" Click="RebuildSummaryButton_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Решения">
                                <ListView x:Name="DecisionList" Margin="12"><ListView.View><GridView><GridViewColumn Header="Решение" Width="600" DisplayMemberBinding="{Binding Text}"/><GridViewColumn Header="Статус" Width="130" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView>
                            </TabItem>
                            <TabItem Header="Поручения">
                                <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ListView x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="Поручение" Width="430" DisplayMemberBinding="{Binding Task}"/><GridViewColumn Header="Ответственный" Width="160" DisplayMemberBinding="{Binding Responsible}"/><GridViewColumn Header="Статус" Width="130" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView>
                                    <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="150"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="TaskEditBox" Grid.Column="0" Padding="7" Margin="0,0,8,0" ToolTip="Текст поручения"/><TextBox x:Name="TaskResponsibleBox" Grid.Column="1" Padding="7" Margin="0,0,8,0" ToolTip="Ответственный"/><TextBox x:Name="TaskDeadlineBox" Grid.Column="2" Padding="7" Margin="0,0,8,0" ToolTip="Срок: ГГГГ-ММ-ДД ЧЧ:ММ"/><ComboBox x:Name="TaskStatusBox" Grid.Column="3" Padding="5" Margin="0,0,8,0" ToolTip="Статус поручения"><ComboBoxItem Content="NEEDS_REVIEW"/><ComboBoxItem Content="OPEN"/><ComboBoxItem Content="DONE"/><ComboBoxItem Content="CANCELLED"/></ComboBox><Button Grid.Column="4" Content="Сохранить" Click="SaveTaskButton_Click"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Администрирование">
                <Grid Margin="18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Локальный backend и workers" FontSize="20" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1" Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <TextBlock Text="API URL" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="ApiUrlTextBox" Grid.Column="1" Text="http://localhost:8080" Padding="8"/>
                        <TextBlock Grid.Column="2" Text="Пользователь" VerticalAlignment="Center" Margin="18,0,8,0"/><TextBox x:Name="UsernameTextBox" Grid.Column="3" Text="admin" Padding="8"/>
                        <TextBlock Grid.Column="4" Text="Пароль" VerticalAlignment="Center" Margin="18,0,8,0"/><PasswordBox x:Name="PasswordBox" Grid.Column="5" Padding="8"/>
                    </Grid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="Подключение Recorder Service" FontSize="17" FontWeight="SemiBold"/>
                        <Grid Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="300"/><ColumnDefinition Width="220"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Имя агента" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="AgentNameBox" Grid.Column="1" Text="WhisperX Atom Desktop" Padding="8"/>
                            <TextBlock Grid.Column="2" Text="Enrollment secret" VerticalAlignment="Center" Margin="18,0,8,0"/><PasswordBox x:Name="EnrollmentSecretBox" Grid.Column="3" Padding="8"/><Button Grid.Column="4" Content="Зарегистрировать агента" Click="EnrollAgentButton_Click" Margin="12,0,0,8"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal"><Button Content="Диагностика Docker" Click="DockerStatusButton_Click"/><Button Content="Открыть серверные данные" Click="OpenDataFolderButton_Click"/><Button Content="Открыть spool Agent" Click="OpenAgentSpoolButton_Click"/></StackPanel>
                        <StackPanel Orientation="Horizontal"><Button Content="Войти в API" Click="LoginButton_Click"/><Button Content="Проверить backend" Click="CheckServerButton_Click"/></StackPanel>
                        <TextBlock x:Name="AdminStatusText" Text="Не подключено" Foreground="#9AA8BA" TextWrapping="Wrap"/>
                        <TextBlock Text="Сервер Docker/WSL2 запускается отдельно; приложение остаётся единым Desktop-интерфейсом." Foreground="#66D9EF" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <TextBlock Text="Для импорта используйте кнопку «Импорт файла»; Inbox не сканируется автоматически." Foreground="#9AA8BA" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" x:Name="FooterText" Text="Готово" Foreground="#718096" Margin="0,14,0,0"/>
    </Grid>
</Window>
