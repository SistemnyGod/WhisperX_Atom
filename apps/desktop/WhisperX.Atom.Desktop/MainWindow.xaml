<Window x:Class="WhisperX.Atom.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperX Atom Desktop" Width="1586" Height="992" MinWidth="1180" MinHeight="720"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="NavTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource SurfaceBlueBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#C9DCFF"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#F6F9FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="15,11"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="SectionBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SectionBorder" Property="Background" Value="{StaticResource SurfaceBlueBrush}"/>
                                <Setter TargetName="SectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentStrongBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SectionBorder" Property="Background" Value="#FAFCFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SoftCardBorder" TargetType="{x:Type Border}" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style x:Key="MetricIconBorder" TargetType="{x:Type Border}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="CornerRadius" Value="17"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>

        <Style x:Key="EyebrowText" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="PageSubtitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SurfaceBlueBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#C6D9FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#FAFCFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ListViewItem}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26,16,26,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="64" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="286"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" Background="{StaticResource AccentBrush}" CornerRadius="11" Margin="0,0,11,0">
                    <TextBlock Text="W" Foreground="White" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                </Border>
                <TextBlock Text="WhisperX Atom Desktop" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0"/>
            </StackPanel>

            <Border Grid.Column="1" Width="630" MaxWidth="630" Height="40" HorizontalAlignment="Center"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="11" Padding="13,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               Foreground="{StaticResource MutedTextBrush}" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" x:Name="GlobalSearchBox" Text="Поиск по совещаниям, стенограммам и задачам..."
                             Foreground="{StaticResource MutedTextBrush}" Background="Transparent" BorderThickness="0"
                             MinHeight="0" Padding="0" VerticalContentAlignment="Center"
                             GotFocus="GlobalSearchBox_GotFocus" LostFocus="GlobalSearchBox_LostFocus"
                             TextChanged="GlobalSearchBox_TextChanged" Margin="0"/>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceStrongBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl + K" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="ServerStatusCard" Background="{StaticResource SurfaceStrongBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="16" Padding="10,7" Margin="0,0,14,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ServerStatusIndicator" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,7,0"/>
                            <TextBlock x:Name="ServerStatusText" Text="Система"
                                       Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0"/>
                        </StackPanel>
                            <TextBlock x:Name="AgentStatusText" Text="Recorder Agent: проверка"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                                       Margin="15,2,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                <Border Width="34" Height="34" Background="#5B687D" CornerRadius="17" Margin="0,0,9,0">
                    <TextBlock x:Name="HeaderAvatarText" Text="WX" Foreground="White" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="HeaderUserNameText" Text="Локальный пользователь" FontSize="12" FontWeight="SemiBold" Margin="0"/>
                    <TextBlock x:Name="HeaderUserEmailText" Text="" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0"/>
                </StackPanel>
                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0"/>
            </StackPanel>
        </Grid>

<TabControl x:Name="MainNavigationTabs" Grid.Row="1" TabStripPlacement="Left"
                    MinWidth="250" ItemContainerStyle="{StaticResource NavTabItem}"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0" Padding="0">
                        <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                   Foreground="{StaticResource AccentBrush}" Width="24" Margin="0,0,10,0"/>
                        <TextBlock Text="Главная" Margin="0"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="22,22,22,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="#CFE0FF"
                                    BorderThickness="1" CornerRadius="18" Padding="22" Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="206"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,22,0">
                                        <TextBlock x:Name="RecordingEyebrowText" Text="ГОТОВНОСТЬ К ЗАПИСИ" Foreground="#3564A7"
                                                   FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <TextBox x:Name="RecordingTitleBox" Text="Новая запись" ToolTip="Название будущего совещания"
                                                 FontSize="24" FontWeight="SemiBold" Padding="0"
                                                 BorderThickness="0" Background="Transparent"
                                                 Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="OpenSourcesFromHero_Click"
                                                    ToolTip="Открыть настройки источников записи">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                                                       Margin="0,0,8,0"/>
                                            <TextBlock Text="Источник не выбран" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="13" Margin="0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,20,0,16">
                                            <Ellipse x:Name="RecordingIndicator" Width="20" Height="20" Fill="{StaticResource MutedTextBrush}"
                                                     Margin="0,0,13,0" VerticalAlignment="Center"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="RecordingStateText" Text="Ожидание"
                                                           FontSize="30" FontWeight="SemiBold" Margin="0"/>
                                                <TextBlock x:Name="RecordingTimerText" Text="--:--:--"
                                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                                <TextBlock x:Name="MicrophoneText" Text="Микрофон (комната)"
                                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                                <TextBlock Text="Уровень недоступен до начала записи" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="SystemAudioText" Text="Системный звук"
                                                           Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
                                                <TextBlock Text="Уровень недоступен до начала записи" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="SessionText" Text="Сессия не создана"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="DeviceErrorText" Text="" Foreground="{StaticResource WarningBrush}"
                                                   FontSize="11" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="StorageText" Text="Диск: проверка" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0"/>
                                        <Border x:Name="ProcessingPanel" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="#DCE7F5" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <TextBlock Text="Состояние обработки" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="ProcessingStatusText" Text="Обработка не запущена" Foreground="{StaticResource AccentStrongBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                <ProgressBar x:Name="ProcessingProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,6,0,0"/>
                                                <TextBlock x:Name="ProcessingErrorText" Text="" Foreground="{StaticResource WarningBrush}" FontSize="10" Margin="0,5,0,0"/>
                                                <TextBlock x:Name="LastErrorText" Text="" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Button x:Name="StartRecordingButton" Content="Начать запись"
                                                Click="StartButton_Click" Style="{StaticResource PrimaryButton}"
                                                Height="40" MinWidth="206" Margin="0,0,0,7"/>
                                        <Button x:Name="PauseRecordingButton" Content="Пауза"
                                                Click="PauseButton_Click" IsEnabled="False" Height="38" MinWidth="206" Margin="0,0,0,7"/>
                                        <Button x:Name="ResumeRecordingButton" Content="Продолжить"
                                                Click="ResumeButton_Click" IsEnabled="False" Height="38" MinWidth="206" Margin="0,0,0,7"/>
                                        <Button x:Name="MarkRecordingButton" Content="Метка" Click="MarkButton_Click" IsEnabled="False" Height="38" MinWidth="206" Margin="0,0,0,7"/>
                                        <Button x:Name="StopRecordingButton" Content="Завершить"
                                                Click="StopButton_Click" Style="{StaticResource DangerButton}"
                                                IsEnabled="False" Height="38" MinWidth="206" Margin="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.05*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource SoftCardBorder}" Padding="13" Margin="0,0,5,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBorder}" Background="{StaticResource SurfaceBlueBrush}">
                                            <TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" Foreground="#2876FF" FontSize="17"/>
                                        </Border>
                                        <TextBlock Text="Активные записи" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="DashboardActiveText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,6"/>
                                        <TextBlock x:Name="DashboardActiveHintText" Text="Ожидание данных агента" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Padding="13" Margin="5,0,5,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBorder}" Background="{StaticResource SurfacePurpleBrush}">
                                            <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="#793BFF" FontSize="17"/>
                                        </Border>
                                        <TextBlock Text="В обработке" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="DashboardProcessingText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,6"/>
                                        <TextBlock Text="По данным API" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCardBorder}" Padding="13" Margin="5,0,5,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBorder}" Background="{StaticResource SurfaceGreenBrush}">
                                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource SuccessBrush}" FontSize="17"/>
                                        </Border>
                                        <TextBlock Text="Готовые саммари" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="DashboardSummariesText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,6"/>
                                        <TextBlock Text="По данным API" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Style="{StaticResource SoftCardBorder}" Padding="13" Margin="5,0,5,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBorder}" Background="{StaticResource SurfaceOrangeBrush}">
                                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#FF6A1A" FontSize="17"/>
                                        </Border>
                                        <TextBlock Text="Открытые задачи" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="DashboardTasksText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,6"/>
                                        <TextBlock Text="По данным API" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource SoftCardBorder}" Padding="13" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="Состояние GPU" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        <Border Style="{StaticResource MetricIconBorder}" Background="{StaticResource SurfacePurpleBrush}">
                                            <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Foreground="#793BFF" FontSize="16"/>
                                        </Border>
                                        <TextBlock x:Name="DashboardGpuText" Text="Нет данных" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock Text="Метрика не передаётся агентом" Foreground="{StaticResource MutedTextBrush}" FontSize="10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="5" Style="{StaticResource SoftCardBorder}" Padding="13" Margin="5,0,0,0">
                                    <StackPanel>
                                        <Border Style="{StaticResource MetricIconBorder}" Background="{StaticResource SurfaceBlueBrush}">
                                            <TextBlock Text="&#xE7F1;" FontFamily="Segoe MDL2 Assets" Foreground="#2876FF" FontSize="16"/>
                                        </Border>
                                        <TextBlock Text="Свободное место" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        <TextBlock x:Name="DashboardStorageMetricText" Text="Ожидание проверки" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,6"/>
                                        <ProgressBar x:Name="DashboardStorageBar" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="DashboardStoragePercentText" Text="—" Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Последние совещания" FontSize="16" FontWeight="SemiBold" Margin="0"/>
                                        <Button Grid.Column="1" Content="Открыть все совещания →" Style="{StaticResource GhostButton}"
                                                Click="OpenMeetingsLink_Click" Margin="0" Padding="0" HorizontalContentAlignment="Right"/>
                                    </Grid>
                                    <Grid Grid.Row="1" Background="{StaticResource SurfaceStrongBrush}" Margin="0,0,0,4" Height="30">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Дата" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Название" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="Статус" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Описание" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="Действие" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <ItemsControl x:Name="DashboardMeetingsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,9"
                                                            Cursor="Hand" MouseLeftButtonUp="DashboardMeetingRow_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="11"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <Border Grid.Column="2" Background="{StaticResource SurfaceBlueBrush}" CornerRadius="6" Padding="7,4" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentStrongBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="4" Text="Открыть →" Foreground="{StaticResource AccentStrongBrush}" FontSize="10"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel x:Name="DashboardMeetingsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24">
                                            <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource SurfaceBlueBrush}" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="19"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock x:Name="DashboardMeetingsEmptyText" Text="Нет загруженных совещаний"
                                                       Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="DashboardMeetingsEmptyHintText" Text="Войдите в API или импортируйте первую запись"
                                                       Foreground="{StaticResource MutedTextBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                            <StackPanel x:Name="DashboardMeetingsEmptyActions" Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="Обновить" Click="LoadMeetingsButton_Click" Padding="12,7" Margin="0,0,6,0"/>
                                                <Button Content="Загрузить файл" Click="ImportFileButton_Click" Style="{StaticResource PrimaryButton}" Padding="12,7"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Быстрые действия" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Button Content="＋  Новое совещание" Style="{StaticResource PrimaryButton}" MinWidth="290" HorizontalContentAlignment="Left"
                                            Click="NewMeetingQuickAction_Click"/>
                                    <Button x:Name="ImportButton" Content="Загрузить файл"
                                            Click="ImportFileButton_Click" MinWidth="290" HorizontalContentAlignment="Left"/>
                                    <Button Content="Настроить подключения" MinWidth="290" HorizontalContentAlignment="Left"
                                            Click="OpenSettingsQuickAction_Click"/>
                                    <Button Content="Импорт из календаря" MinWidth="290" HorizontalContentAlignment="Left" IsEnabled="False"/>
                                    <Button Content="Экспорт журнала" MinWidth="290" HorizontalContentAlignment="Left" IsEnabled="False"/>
                                    <TextBlock Text="Календарь и экспорт пока не подключены" Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Состояние агента" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <Ellipse x:Name="AgentStatusIndicator" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ElementName=AgentStatusText, Path=Text}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding ElementName=ProcessingStatusText, Path=Text}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                        <TextBlock Text="Метрики нагрузки не передаются агентом" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                        <Button Content="Открыть настройки агента →" Style="{StaticResource GhostButton}"
                                                Click="OpenSettingsQuickAction_Click" HorizontalContentAlignment="Left"
                                                Padding="0" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource CardBorder}" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Последние уведомления" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="NotificationsEmptyText" Text="Нет новых уведомлений" Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

<TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" Width="24" Margin="0,0,10,0"/><TextBlock Text="Совещания"/></StackPanel></TabItem.Header>
                <Grid Margin="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Совещания" Style="{StaticResource PageTitle}"/>
                        <TextBlock Grid.Row="1" Text="История записей и импорт файлов" Style="{StaticResource PageSubtitle}"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,10">
                            <Button Content="Обновить" Click="LoadMeetingsButton_Click"/>
                            <Button Content="Импортировать" Click="ImportFileButton_Click" Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <TextBox x:Name="MeetingSearchBox" ToolTip="Поиск по названию или статусу" TextChanged="MeetingSearchBox_TextChanged" Margin="0,0,0,8"/>
                            <TextBlock x:Name="MeetingCountText" Text="Совещания ещё не загружены" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,10"/>
                            <ListBox x:Name="MeetingsList" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="MeetingsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentStrongBrush}" FontSize="12" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:g}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBox x:Name="NewMeetingTitleBox" Visibility="Collapsed"/>
                            <TextBlock x:Name="ImportStatusText" Text="Выберите аудио или видеофайл" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Style="{StaticResource SoftCardBorder}" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="ВЫБРАННОЕ СОВЕЩАНИЕ" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock x:Name="SelectedMeetingTitle" Text="Выберите совещание слева" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="SelectedMeetingStatus" Text="История и результаты появятся после выбора записи" Foreground="{StaticResource MutedTextBrush}" Margin="0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{StaticResource SurfaceBlueBrush}" BorderBrush="#C6D9FF" BorderThickness="1" CornerRadius="16" Padding="13,8" VerticalAlignment="Top">
                                    <TextBlock Text="Рабочая область" Foreground="{StaticResource AccentStrongBrush}" FontSize="12" FontWeight="SemiBold" Margin="0"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Плеер" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="PlayerStatusText" Text="Медиафайл не выбран" FontWeight="SemiBold" Margin="0"/>
                                    <Slider x:Name="PositionSlider" Minimum="0" Maximum="1" ValueChanged="PositionSlider_ValueChanged" Margin="0,10,0,2"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,18,0">
                                    <Button Content="Воспроизвести" Click="PlayButton_Click"/>
                                    <Button Content="Пауза" Click="PlayerPauseButton_Click"/>
                                    <Button Content="Стоп" Click="PlayerStopButton_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="Плеер закреплён в шапке" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Right"/>
                                    <Grid Width="1" Height="1" Opacity="0">
                                        <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      Stretch="Uniform" MediaFailed="PreviewPlayer_MediaFailed"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TabControl Grid.Row="2" ItemContainerStyle="{StaticResource SectionTabItem}"
                                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <TabItem Header="Обзор">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="22">
                                        <TextBlock Text="Pipeline обработки" Style="{StaticResource SectionTitle}"/>
                                        <Grid Margin="0,0,0,18">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Style="{StaticResource SoftCardBorder}" Padding="14" Margin="0,0,6,0"><StackPanel><TextBlock Text="01" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Загрузка" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                            <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Padding="14" Margin="6,0,6,0"><StackPanel><TextBlock Text="02" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Нормализация" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                            <Border Grid.Column="2" Style="{StaticResource SoftCardBorder}" Padding="14" Margin="6,0,6,0"><StackPanel><TextBlock Text="03" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Распознавание" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                            <Border Grid.Column="3" Style="{StaticResource SoftCardBorder}" Padding="14" Margin="6,0,0,0"><StackPanel><TextBlock Text="04" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="Результаты" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Border>
                                        </Grid>
                                        <Border Style="{StaticResource SoftCardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Что можно сделать" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="Выберите запись слева, чтобы загрузить стенограмму, спикеров, саммари, решения и поручения." Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="Ошибки обработки и повторные действия будут показаны здесь." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Стенограмма">
                                <Grid Margin="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,14,0">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <TextBlock x:Name="TranscriptStatusText" Text="Стенограмма ещё не готова" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,10"/>
                                        <ListView x:Name="TranscriptList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                  SelectionChanged="TranscriptList_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Speaker}" Foreground="{StaticResource AccentStrongBrush}" TextWrapping="Wrap"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                    <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Padding="16">
                                        <StackPanel>
                                            <TextBlock Text="Участники" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Переименуйте спикера или объедините кластеры." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,12"/>
                                            <ListView x:Name="SpeakerList" Height="190" SelectionChanged="SpeakerList_SelectionChanged">
                                                <ListView.View>
                                                    <GridView>
                                                        <GridViewColumn Header="Ключ" Width="100" DisplayMemberBinding="{Binding StableKey}"/>
                                                        <GridViewColumn Header="Имя" Width="140" DisplayMemberBinding="{Binding DisplayName}"/>
                                                    </GridView>
                                                </ListView.View>
                                            </ListView>
                                            <TextBlock Text="Имя выбранного спикера" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,12,0,4"/>
                                            <TextBox x:Name="SpeakerNameBox" Margin="0,0,0,8"/>
                                            <Button Content="Переименовать" Click="RenameSpeakerButton_Click" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Объединить кластеры" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,8,0,4"/>
                                            <ComboBox x:Name="MergeSourceBox" DisplayMemberPath="DisplayName" Margin="0,0,0,6"/>
                                            <ComboBox x:Name="MergeTargetBox" DisplayMemberPath="DisplayName" Margin="0,0,0,6"/>
                                            <Button Content="Объединить" Click="MergeSpeakersButton_Click" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Саммари">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBox x:Name="SummaryTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                             Background="#F8FBFA" Foreground="{StaticResource TextBrush}" Padding="16"/>
                                    <Button Grid.Row="1" Content="Пересобрать саммари" Click="RebuildSummaryButton_Click"
                                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Решения">
                                <ListView x:Name="DecisionList" Margin="16">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="Решение" Width="600" DisplayMemberBinding="{Binding Text}"/>
                                            <GridViewColumn Header="Статус" Width="150" DisplayMemberBinding="{Binding Status}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </TabItem>
                            <TabItem Header="Поручения">
                                <Grid Margin="16">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <ListView x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged">
                                        <ListView.View>
                                            <GridView>
                                                <GridViewColumn Header="Поручение" Width="420" DisplayMemberBinding="{Binding Task}"/>
                                                <GridViewColumn Header="Ответственный" Width="180" DisplayMemberBinding="{Binding Responsible}"/>
                                                <GridViewColumn Header="Статус" Width="150" DisplayMemberBinding="{Binding Status}"/>
                                            </GridView>
                                        </ListView.View>
                                    </ListView>
                                    <Grid Grid.Row="1" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="TaskEditBox" Grid.Column="0" Margin="0,0,8,0" ToolTip="Описание поручения"/>
                                        <TextBox x:Name="TaskResponsibleBox" Grid.Column="1" Margin="0,0,8,0" ToolTip="Ответственный"/>
                                        <TextBox x:Name="TaskDeadlineBox" Grid.Column="2" Margin="0,0,8,0" ToolTip="Срок: ГГГГ-ММ-ДД ЧЧ:ММ"/>
                                        <ComboBox x:Name="TaskStatusBox" Grid.Column="3" Margin="0,0,8,0">
                                            <ComboBoxItem Content="NEEDS_REVIEW"/><ComboBoxItem Content="OPEN"/><ComboBoxItem Content="DONE"/><ComboBoxItem Content="CANCELLED"/>
                                        </ComboBox>
                                        <Button Grid.Column="4" Content="Сохранить" Click="SaveTaskButton_Click" Style="{StaticResource PrimaryButton}"/>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="Файлы">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="22">
                                        <TextBlock Text="Файлы совещания" Style="{StaticResource SectionTitle}"/>
                                        <Border Style="{StaticResource SoftCardBorder}">
                                            <StackPanel>
                                                <TextBlock Text="Исходная запись, preview и результаты обработки доступны после выбора совещания." Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text="Если файл ещё загружается, статус появится в верхней панели совещания." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" Width="24" Margin="0,0,10,0"/><TextBlock Text="Источники"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30">
                        <TextBlock Text="Источники записи" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Подключения, устройства и состояние Recorder Agent в одном месте." Style="{StaticResource PageSubtitle}"/>
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="RECORDER AGENT" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Состояние источника" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Текущее соединение видно в верхней панели. Для записи нужен подключённый Windows Recorder Agent." Foreground="{StaticResource MutedTextBrush}"/>
                                    <Button Content="Обновить состояния" Click="RefreshButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Margin="9,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="УСТРОЙСТВА" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Захват звука" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding ElementName=MicrophoneText, Path=Text}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ElementName=SystemAudioText, Path=Text}" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="{Binding ElementName=StorageText, Path=Text}" Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SoftCardBorder}" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="РЕГИСТРАЦИЯ" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Новый Agent" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Имя Agent и enrollment secret задаются в Инженерных настройках." Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="После регистрации обновите состояние источников." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73A;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" Width="24" Margin="0,0,10,0"/><TextBlock Text="Поручения"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30">
                        <TextBlock Text="Поручения" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Общий реестр задач из совещаний. Откройте запись, чтобы изменить evidence, статус и срок." Style="{StaticResource PageSubtitle}"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,22,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Реестр готовится" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Список задач будет собираться из обработанных совещаний. Пока используйте вкладку «Поручения» внутри выбранного совещания." Foreground="{StaticResource MutedTextBrush}" MaxWidth="720"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Открыть совещания" Click="LoadMeetingsButton_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SoftCardBorder}" Margin="0,0,9,0"><StackPanel><TextBlock Text="Срок" Style="{StaticResource SectionTitle}"/><TextBlock Text="Фильтр по дедлайну будет доступен здесь." Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
                            <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Margin="9,0,9,0"><StackPanel><TextBlock Text="Статус" Style="{StaticResource SectionTitle}"/><TextBlock Text="Открытые, на проверке и завершённые задачи." Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource SoftCardBorder}" Margin="9,0,0,0"><StackPanel><TextBlock Text="Ответственный" Style="{StaticResource SectionTitle}"/><TextBlock Text="Связь с человеком и исходной репликой." Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" Width="24" Margin="0,0,10,0"/><TextBlock Text="Помощник"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30">
                        <TextBlock Text="Голосовой помощник" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Локальные команды и вопросы по истории совещаний в одном рабочем пространстве." Style="{StaticResource PageSubtitle}"/>

                        <Grid Margin="0,22,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="VOICE HOST" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Состояние помощника" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Экспериментальный режим до завершения микрофонной приёмки" Foreground="{StaticResource WarningBrush}"/>
                                    <TextBlock x:Name="VoiceStateText" Text="SessionHost не подключён" Foreground="{StaticResource AccentStrongBrush}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="VoiceReadinessText" Text="Модель, микрофон и служба записи: проверка" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="VoiceMetricsText" Text="Метрики ещё не получены" Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock x:Name="VoiceLastText" Text="Команда ещё не распознана" Foreground="{StaticResource AccentStrongBrush}" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <CheckBox x:Name="VoiceEnabledCheckBox" Content="Включён" IsChecked="True" Checked="VoiceEnabledCheckBox_Changed" Unchecked="VoiceEnabledCheckBox_Changed"/>
                                        <CheckBox x:Name="VoiceQuietCheckBox" Content="Тихий режим" Checked="VoiceQuietCheckBox_Changed" Unchecked="VoiceQuietCheckBox_Changed"/>
                                        <Button Content="Обновить" Click="VoiceRefreshButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="БЫСТРАЯ КОМАНДА" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Говорите короткими командами" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="Зажмите кнопку, произнесите команду и отпустите. Для диагностики доступны тест звука и проверка помощника." Foreground="{StaticResource MutedTextBrush}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                        <Button x:Name="VoicePttButton" Content="Нажмите и говорите" PreviewMouseLeftButtonDown="VoicePttButton_Down"
                                                PreviewMouseLeftButtonUp="VoicePttButton_Up" MouseLeave="VoicePttButton_Leave"
                                                Style="{StaticResource PrimaryButton}" MinWidth="190"/>
                                        <ComboBox x:Name="VoiceSensitivityBox" Width="130" SelectedIndex="1" SelectionChanged="VoiceSensitivityBox_SelectionChanged">
                                            <ComboBoxItem Content="low"/><ComboBoxItem Content="balanced"/><ComboBoxItem Content="high"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Проверить звук" Click="VoiceTtsButton_Click"/>
                                        <Button x:Name="VoiceDoctorButton" Content="Проверить помощник" Click="VoiceDoctorButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <TextBlock Text="ЛОКАЛЬНАЯ КОМАНДА" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Выполнить текстом" Style="{StaticResource SectionTitle}"/>
                                    <TextBox x:Name="VoiceTextBox" Margin="0,0,0,10"/>
                                    <Button Content="Выполнить" Click="VoiceTextButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="VoiceErrorText" Text="" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="ИСТОРИЯ СОВЕЩАНИЙ" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Задать вопрос" Style="{StaticResource SectionTitle}"/>
                                    <TextBox x:Name="AssistantQuestionBox" Height="78" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <Button Content="Спросить по истории" Click="AssistantQuestionButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/>
                                    <Border Background="{StaticResource SurfaceGreenBrush}" BorderBrush="#D7EBDD" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="AssistantAnswerText" Text="Ответ появится после обработки запроса." FontWeight="SemiBold"/>
                                            <TextBlock x:Name="AssistantEvidenceText" Text="Evidence появится здесь." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentBrush}" Width="24" Margin="0,0,10,0"/><TextBlock Text="Настройки"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="30">
                        <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Повседневные параметры остаются простыми; диагностика и подключение вынесены ниже." Style="{StaticResource PageSubtitle}"/>
                        <Grid Margin="0,22,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,9,0">
                                <StackPanel>
                                    <TextBlock Text="ЗАПИСЬ" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Источники звука" Style="{StaticResource SectionTitle}"/>
                                    <CheckBox Content="Микрофон: Windows по умолчанию" IsChecked="True" IsEnabled="False"/>
                                    <CheckBox Content="Системный звук: Windows по умолчанию" IsChecked="True" IsEnabled="False"/>
                                    <CheckBox Content="Тихий режим голосового помощника" IsEnabled="False" ToolTip="Настройка доступна в разделе Помощник"/>
                                    <TextBlock Text="Изменение устройств записи пока управляется Windows." Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SoftCardBorder}" Margin="9,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="ДИАГНОСТИКА" Style="{StaticResource EyebrowText}"/>
                                    <TextBlock Text="Системный статус" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="API и Recorder Agent доступны через индикаторы в верхней панели." Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="Для подключения и регистрации Agent откройте инженерный режим." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Expander x:Name="EngineeringPanel" IsEnabled="False" Header="Инженерные настройки" Foreground="{StaticResource WarningBrush}"
                                  Padding="0" IsExpanded="False">
                            <Border Style="{StaticResource SoftCardBorder}" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="Раздел для диагностики локального API, Docker/WSL2 и Recorder Service." Foreground="{StaticResource MutedTextBrush}"/>
                                    <Grid Margin="0,16,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="170"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                        <Label Content="API URL"/><TextBox x:Name="ApiUrlTextBox" Grid.Column="1" Text="http://localhost:8080" Margin="10,0,14,8"/>
                                        <Label Grid.Column="2" Content="Пользователь"/><TextBox x:Name="UsernameTextBox" Grid.Column="3" Text="admin" Margin="10,0,14,8"/>
                                        <Label Grid.Column="4" Content="Пароль"/><PasswordBox x:Name="PasswordBox" Grid.Column="5" Margin="10,0,0,8"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Войти в API" Click="LoginButton_Click" Style="{StaticResource PrimaryButton}"/>
                                        <Button Content="Проверить backend" Click="CheckServerButton_Click"/>
                                        <Button Content="Диагностика Docker" Click="DockerStatusButton_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AdminStatusText" Text="Инженерный режим не активирован" Foreground="{StaticResource MutedTextBrush}"/>
                                    <Grid Margin="0,14,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Label Content="Имя Agent"/><TextBox x:Name="AgentNameBox" Grid.Column="1" Text="WhisperX Atom Desktop" Margin="10,0,14,8"/>
                                        <Label Grid.Column="2" Content="Enrollment secret"/><PasswordBox x:Name="EnrollmentSecretBox" Grid.Column="3" Margin="10,0,14,8"/>
                                        <Button Grid.Column="4" Content="Зарегистрировать" Click="EnrollAgentButton_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Открыть данные сервера" Click="OpenDataFolderButton_Click"/>
                                        <Button Content="Открыть spool Agent" Click="OpenAgentSpoolButton_Click"/>
                                        <Button Content="Открыть журнал помощника" Click="VoiceOpenLogButton_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Text="Готово" Foreground="{StaticResource MutedTextBrush}" Margin="0"/>
            <TextBlock Grid.Column="1" Text="WhisperX Atom · локальная обработка" Foreground="{StaticResource MutedTextBrush}" Margin="0"/>
        </Grid>
    </Grid>
</Window>
