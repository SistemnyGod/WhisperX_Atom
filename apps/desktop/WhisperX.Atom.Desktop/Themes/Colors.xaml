<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PageBackgroundColor">#F4F7FB</Color>
    <Color x:Key="SidebarColor">#F8FAFD</Color>
    <Color x:Key="FooterColor">#EEF3F9</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceBlueColor">#EEF5FF</Color>
    <Color x:Key="SurfaceGreenColor">#EAF8F0</Color>
    <Color x:Key="SurfaceOrangeColor">#FFF1E8</Color>
    <Color x:Key="BorderColor">#D9E3F0</Color>
    <Color x:Key="HeroBorderColor">#C8DCFF</Color>
    <Color x:Key="TableHeaderColor">#F0F4F9</Color>
    <Color x:Key="NeutralStatusColor">#7B8EA4</Color>
    <Color x:Key="TextColor">#172338</Color>
    <Color x:Key="MutedTextColor">#66758C</Color>
    <Color x:Key="AccentColor">#1967F2</Color>
    <Color x:Key="AccentHoverColor">#0F54D6</Color>
    <Color x:Key="SuccessColor">#16A45C</Color>
    <Color x:Key="WarningColor">#F79009</Color>
    <Color x:Key="DangerColor">#D64550</Color>
    <Color x:Key="DangerSurfaceColor">#FFF6F6</Color>
    <Color x:Key="DangerBorderColor">#F0B9BE</Color>
    <Color x:Key="InfoSurfaceColor">#EEF5FF</Color>
    <Color x:Key="DisabledSurfaceColor">#F1F4F8</Color>
    <Color x:Key="DisabledTextColor">#8996A8</Color>

    <!-- Semantic aliases used by the workspace. Keep legacy keys above for compatibility. -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource HeroBorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="{StaticResource InfoSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />

    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="FooterBrush" Color="{StaticResource FooterColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceBlueBrush" Color="{StaticResource SurfaceBlueColor}" />
    <SolidColorBrush x:Key="SurfaceGreenBrush" Color="{StaticResource SurfaceGreenColor}" />
    <SolidColorBrush x:Key="SurfaceOrangeBrush" Color="{StaticResource SurfaceOrangeColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="HeroBorderBrush" Color="{StaticResource HeroBorderColor}" />
    <SolidColorBrush x:Key="TableHeaderBrush" Color="{StaticResource TableHeaderColor}" />
    <SolidColorBrush x:Key="NeutralStatusBrush" Color="{StaticResource NeutralStatusColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSurfaceBrush" Color="{StaticResource DangerSurfaceColor}" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="{StaticResource DangerBorderColor}" />
</ResourceDictionary>
