<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WhisperX_Atom_Desktop.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhisperX Atom — Вход">
    <Grid Width="520" MinHeight="430" Padding="40" Background="#FFF8FAFC">
        <StackPanel Spacing="18" VerticalAlignment="Center">
            <TextBlock Text="WhisperX Atom" FontSize="30" FontWeight="SemiBold" Foreground="#FF172033" />
            <TextBlock Text="Вход пользователя" FontSize="20" Foreground="#FF344054" />
            <TextBlock Text="Для записи и просмотра данных войдите в LAN-сервер." TextWrapping="Wrap" Foreground="#FF667085" />

            <TextBlock Text="Сервер" Foreground="#FF667085" />
            <TextBox x:Name="ApiUrlBox" IsReadOnly="True" />
            <TextBlock Text="Логин" Foreground="#FF667085" />
            <TextBox x:Name="UsernameBox" Text="admin" />
            <TextBlock Text="Пароль" Foreground="#FF667085" />
            <PasswordBox x:Name="PasswordBox" PlaceholderText="Введите пароль" />
            <Button x:Name="LoginButton" Content="Войти" Click="LoginButton_Click" HorizontalAlignment="Stretch" />
            <ProgressRing x:Name="BusyRing" IsActive="False" IsIndeterminate="True" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#FFB42318" />
            <TextBlock Text="При недоступном сервере ранее подтверждённая локальная запись может продолжиться офлайн." TextWrapping="Wrap" Foreground="#FF667085" FontSize="12" />
        </StackPanel>
    </Grid>
</Window>
