<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WhisperX_Atom_Desktop.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhisperX Atom — Вход">
    <Grid Background="{StaticResource AppBackgroundBrush}" Padding="32">
        <Border MaxWidth="520" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CardStyle}">
            <StackPanel Spacing="14">
                <TextBlock Text="WhisperX Atom" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Вход в рабочее пространство" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Войдите в LAN-сервер, чтобы просматривать совещания и синхронизировать локальные записи." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />

                <TextBlock Text="Сервер" Style="{StaticResource WorkspaceLabelStyle}" Margin="0,8,0,0" />
                <TextBox x:Name="ApiUrlBox" IsReadOnly="True" Style="{StaticResource InputStyle}" AutomationProperties.Name="Адрес сервера" />
                <TextBlock Text="Логин" Style="{StaticResource WorkspaceLabelStyle}" />
                <TextBox x:Name="UsernameBox" Text="admin" Style="{StaticResource InputStyle}" AutomationProperties.Name="Логин" />
                <TextBlock Text="Пароль" Style="{StaticResource WorkspaceLabelStyle}" />
                <PasswordBox x:Name="PasswordBox" PlaceholderText="Введите пароль" Style="{StaticResource PasswordInputStyle}" AutomationProperties.Name="Пароль" />
                <Button x:Name="LoginButton" Content="Войти" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Войти в LAN-сервер" />
                <ProgressRing x:Name="BusyRing" IsActive="False" IsIndeterminate="True" HorizontalAlignment="Center" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" />
                <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <TextBlock Text="После первого входа запись может продолжаться локально при временной недоступности сервера." Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
