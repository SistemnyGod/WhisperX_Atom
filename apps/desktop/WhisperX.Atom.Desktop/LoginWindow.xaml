<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WhisperX_Atom_Desktop.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WhisperX Atom — Вход">
    <Grid x:Name="LoginRoot" Background="#050D1D" SizeChanged="LoginRoot_SizeChanged">
        <Grid.Resources>
            <SolidColorBrush x:Key="LoginCardBrush" Color="#E60B1527" />
            <SolidColorBrush x:Key="LoginBorderBrush" Color="#4D6A82AA" />
            <SolidColorBrush x:Key="LoginTextBrush" Color="#F4F7FF" />
            <SolidColorBrush x:Key="LoginMutedBrush" Color="#AAB9D0" />
            <SolidColorBrush x:Key="LoginInputBrush" Color="#A6111F35" />
            <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#526A82A5" />
            <SolidColorBrush x:Key="LoginInfoBrush" Color="#331E4D78" />
            <SolidColorBrush x:Key="LoginDangerBrush" Color="#FFFF8692" />
            <SolidColorBrush x:Key="LoginDangerSurfaceBrush" Color="#663D1726" />
            <SolidColorBrush x:Key="LoginDangerBorderBrush" Color="#99A84D63" />
            <SolidColorBrush x:Key="LoginSuccessBrush" Color="#FF55D897" />
            <SolidColorBrush x:Key="LoginNeutralBrush" Color="#FF94A7C2" />

            <Style x:Key="LoginLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="LoginHintStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource LoginMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="LoginInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource LoginInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LoginInputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="PlaceholderForeground" Value="{StaticResource LoginMutedBrush}" />
            </Style>
            <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource LoginInputBrush}" />
                <Setter Property="Foreground" Value="{StaticResource LoginTextBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource LoginInputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="9" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="MinHeight" Value="46" />
                <Setter Property="FontSize" Value="15" />
            </Style>
            <Style x:Key="LoginCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource LoginMutedBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
        </Grid.Resources>

        <Image x:Name="LoginBackgroundImage" Source="Assets/LoginBackground.png" Stretch="UniformToFill" Opacity="0.92" />
        <Rectangle Fill="#78050D1F" />
        <Rectangle Fill="#26030A18" />

        <ScrollViewer x:Name="LoginScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="LoginContentGrid" Padding="36,28">
                <Border x:Name="LoginCard"
                    MinWidth="480"
                    MaxWidth="520"
                    Padding="40,34,40,30"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{StaticResource LoginCardBrush}"
                    BorderBrush="{StaticResource LoginBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20">
                    <StackPanel Spacing="16">
                        <StackPanel HorizontalAlignment="Center" Spacing="9">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <Border Width="38" Height="38" CornerRadius="11" Background="#FF1967F2">
                                    <FontIcon Glyph="&#xE720;" Foreground="White" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="WhisperX Atom" Foreground="{StaticResource LoginTextBrush}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="Добро пожаловать!" Foreground="{StaticResource LoginTextBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Войдите, чтобы продолжить работу с совещаниями" Style="{StaticResource LoginHintStyle}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="ServerOriginLabel" Text="LAN-сервер · проверяется" Style="{StaticResource LoginHintStyle}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="440" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="LoginUpdateNotice" Visibility="Collapsed" Background="#33206BD9" BorderBrush="#665B9BFF" BorderThickness="1" CornerRadius="8" Padding="10,7" MaxWidth="440" MinHeight="40">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock x:Name="LoginUpdateText" Text="Доступна новая версия" Foreground="{StaticResource LoginTextBrush}" TextWrapping="Wrap" MaxLines="2" />
                                    <Button Grid.Column="1" x:Name="LoginUpdateDownloadButton" Content="Скачать" Click="LoginUpdateDownloadButton_Click" MinHeight="32" Padding="12,4" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="Логин или e-mail" Style="{StaticResource LoginLabelStyle}" />
                            <TextBox x:Name="UsernameBox" Text="admin" PlaceholderText="Введите логин" Style="{StaticResource LoginInputStyle}" AutomationProperties.Name="Логин" KeyDown="CredentialBox_KeyDown" TextChanged="CredentialBox_TextChanged" />
                            <TextBlock x:Name="UsernameErrorText" Text="Введите логин" Foreground="{StaticResource LoginDangerBrush}" FontSize="12" Height="16" Opacity="0" />
                        </StackPanel>

                        <StackPanel Spacing="7">
                            <TextBlock Text="Пароль" Style="{StaticResource LoginLabelStyle}" />
                            <Grid>
                            <PasswordBox x:Name="PasswordBox" PlaceholderText="Введите пароль" Style="{StaticResource LoginPasswordStyle}" AutomationProperties.Name="Пароль" KeyDown="CredentialBox_KeyDown" PasswordChanged="PasswordBox_PasswordChanged" Padding="14,10,48,10" />
                            <TextBox x:Name="PasswordTextBox" PlaceholderText="Введите пароль" Style="{StaticResource LoginInputStyle}" AutomationProperties.Name="Пароль" KeyDown="CredentialBox_KeyDown" TextChanged="CredentialBox_TextChanged" Padding="14,10,48,10" Visibility="Collapsed" />
                                <Button x:Name="ShowPasswordButton" Width="38" Height="38" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Background="Transparent" BorderBrush="Transparent" Foreground="{StaticResource LoginMutedBrush}" Click="TogglePasswordVisibility_Click" AutomationProperties.Name="Показать пароль">
                                    <FontIcon x:Name="PasswordVisibilityIcon" Glyph="&#xE7B3;" FontSize="16" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="PasswordErrorText" Text="Введите пароль" Foreground="{StaticResource LoginDangerBrush}" FontSize="12" Height="16" Opacity="0" />
                        </StackPanel>

                        <CheckBox x:Name="RememberLoginCheckBox" Content="Запомнить логин на этом компьютере" IsChecked="True" Style="{StaticResource LoginCheckBoxStyle}" Foreground="{StaticResource LoginTextBrush}" AutomationProperties.Name="Запомнить логин на этом компьютере" />

                        <Button x:Name="LoginButton" Style="{StaticResource PrimaryButtonStyle}" Click="LoginButton_Click" HorizontalAlignment="Stretch" MinHeight="52" FontSize="16" AutomationProperties.Name="Войти в LAN-сервер">
                            <Grid>
                                <TextBlock Text="Войти" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ProgressRing x:Name="BusyRing" IsActive="False" IsIndeterminate="True" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="20" Margin="0,0,14,0" />
                            </Grid>
                        </Button>
                        <Button x:Name="CheckConnectionButton" Content="Проверить соединение" Style="{StaticResource SecondaryButtonStyle}" Click="CheckConnectionButton_Click" HorizontalAlignment="Stretch" AutomationProperties.Name="Проверить соединение с LAN-сервером" />

                        <Border x:Name="StatusSurface" Background="{StaticResource LoginInfoBrush}" BorderBrush="{StaticResource LoginBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,10" MinHeight="52" Opacity="0" MaxHeight="88" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <FontIcon x:Name="StatusIcon" Glyph="&#xE73E;" Foreground="{StaticResource LoginSuccessBrush}" FontSize="16" VerticalAlignment="Top" />
                                <TextBlock x:Name="StatusText" Foreground="{StaticResource LoginTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <Grid x:Name="LoginStatusGrid" Margin="0,2,0,0" ColumnDefinitions="*,*,*,*" ColumnSpacing="8" RowSpacing="8">
                            <StackPanel x:Name="LanStatusCell" Grid.Column="0" Spacing="5" MinHeight="42">
                                <Ellipse x:Name="LanStatusDot" Width="8" Height="8" Fill="{StaticResource LoginNeutralBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="LanStatusText" Text="LAN-сервер проверяется" Style="{StaticResource LoginHintStyle}" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="RecorderStatusCell" Grid.Column="1" Spacing="5" MinHeight="42">
                                <Ellipse x:Name="RecorderStatusDot" Width="8" Height="8" Fill="{StaticResource LoginNeutralBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="RecorderStatusText" Text="Recorder проверяется" Style="{StaticResource LoginHintStyle}" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="WhisperStatusCell" Grid.Column="2" Spacing="5" MinHeight="42">
                                <Ellipse x:Name="WhisperStatusDot" Width="8" Height="8" Fill="{StaticResource LoginNeutralBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="WhisperStatusText" Text="WhisperX проверяется" Style="{StaticResource LoginHintStyle}" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel x:Name="VoiceStatusCell" Grid.Column="3" Spacing="5" MinHeight="42">
                                <Ellipse x:Name="VoiceStatusDot" Width="8" Height="8" Fill="{StaticResource LoginNeutralBrush}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="VoiceStatusText" Text="Мифодий выключен" Style="{StaticResource LoginHintStyle}" FontSize="11" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="3">
                            <TextBlock Text="Локальная запись" Foreground="{StaticResource LoginTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                            <TextBlock Text="Сохраняется на этом компьютере. Сервер нужен для доставки и обработки." Style="{StaticResource LoginHintStyle}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Kept collapsed for compatibility: the configured origin is intentionally not exposed on the login form. -->
        <StackPanel Visibility="Collapsed">
            <TextBlock x:Name="ApiOriginText" Text="Настроенный адрес" />
            <TextBox x:Name="ApiUrlBox" IsReadOnly="True" AutomationProperties.Name="Адрес сервера" />
        </StackPanel>
    </Grid>
</Window>
