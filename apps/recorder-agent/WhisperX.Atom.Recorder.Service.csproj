<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <WhisperXBuildIdentity Condition="'$(WhisperXBuildIdentity)' == ''">1.0.1+audio-float32-pcm16</WhisperXBuildIdentity>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(WhisperXBuildIdentity)</InformationalVersion>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AgentStateMachine.cs;SpoolStore.cs;RecordingContract.cs;AgentIpcProtocol.cs;AgentStorageSettings.cs;RecordingSessionClock.cs;StorageWatermark.cs;AudioDeviceProbe.cs;AudioRuntimeProbe.cs;AudioSampleFormat.cs;AudioContracts.cs;AudioQualityAnalyzer.cs;AudioConfigurationV2.cs;MachineServerConfig.cs;RecorderRuntimeLease.cs;RecorderRuntimeResolver.cs;RecorderRuntimeActivity.cs;RawFinalizerQueueMetrics.cs;AudioFrameContinuityValidator.cs;DeliveryWakeSignal.cs;LocalMeetingDirectoryResolver.cs;LocalPlayableAudioWriter.cs;LegacyWasapiCaptureEngine.cs;LegacyWasapiDeviceProbe.cs;AudioRuntimeProbe\**;RecorderTelemetrySelector.cs;AudioPhaseQualityGate.cs" />
    <ProjectReference Include="WhisperX.Atom.Recorder.Core.csproj" />
    <!-- NAudio is isolated to the legacy Windows adapter and probe. It is not
         part of Recorder.Core or the AudioGraph Host. -->
    <Compile Include="AudioSampleFormat.cs" />
    <Compile Include="LegacyWasapiCaptureEngine.cs" />
    <Compile Include="LegacyWasapiDeviceProbe.cs" />
    <Compile Include="AudioRuntimeProbe.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
