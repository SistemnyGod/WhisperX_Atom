<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <WhisperXBuildIdentity Condition="'$(WhisperXBuildIdentity)' == ''">1.0.1+audio-float32-pcm16</WhisperXBuildIdentity>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(WhisperXBuildIdentity)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- Legacy prerecorded replies are intentionally not published.  They
         were produced by an old encoding path and can pronounce Russian text
         incorrectly. Voice Host now always uses the configured live Windows
         Russian voice. -->
    <Content Include="..\Models\Voice\voice-models.manifest.json" Link="Models\Voice\voice-models.manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\vendor\voice-models\voice-models.lock.json" Link="Models\Voice\voice-models.lock.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\vendor\voice-models\vosk-model-small-ru-0.22\**\*" Link="Models\Voice\vosk-model-small-ru-0.22\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhisperX.Atom.Voice.Core\WhisperX.Atom.Voice.Core.csproj" SkipGetTargetFrameworkProperties="true" />
    <!-- Recorder.Core is built by the Desktop/Service publish step. Consume
         its deterministic output directly: a ReferenceOutputAssembly=false
         ProjectReference still asks the SDK for a RID-specific net10.0 asset
         and breaks self-contained VoiceHost publish. -->
    <Reference Include="WhisperX.Atom.Recorder.Core" Condition="Exists('..\..\recorder-agent\bin\core\net10.0\WhisperX.Atom.Recorder.Core.dll')">
      <HintPath>..\..\recorder-agent\bin\core\net10.0\WhisperX.Atom.Recorder.Core.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Speech" Version="10.0.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
</Project>
