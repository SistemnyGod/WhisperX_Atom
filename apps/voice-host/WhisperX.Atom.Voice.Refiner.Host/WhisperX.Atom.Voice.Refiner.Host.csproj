<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <WhisperXBuildIdentity Condition="'$(WhisperXBuildIdentity)' == ''">1.0.1+voice-refiner</WhisperXBuildIdentity>
    <!-- The release identity is supplied explicitly by publish-desktop.ps1.
         Do not append SourceRevisionId a second time to ProductVersion. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(WhisperXBuildIdentity)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WhisperX.Atom.Voice.Core\WhisperX.Atom.Voice.Core.csproj" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
</Project>
