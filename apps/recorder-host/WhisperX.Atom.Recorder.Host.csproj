<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WhisperX.Atom.Recorder.Host</AssemblyName>
    <RootNamespace>WhisperX.Atom.Recorder.Host</RootNamespace>
    <!-- Keep the runtime identity stable and visibly tied to the AudioGraph
         Float32 capture fix. Desktop uses the same identity when validating
         that the launched Host is the binary that was built for this release. -->
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <WhisperXBuildIdentity Condition="'$(WhisperXBuildIdentity)' == ''">1.0.1+audio-float32-pcm16</WhisperXBuildIdentity>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InformationalVersion>$(WhisperXBuildIdentity)</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\recorder-agent\WhisperX.Atom.Recorder.Core.csproj" />
    <Compile Include="..\recorder-agent\AgentApiClient.cs" Link="RecorderCore\AgentApiClient.cs" />
    <Compile Include="..\recorder-agent\FlacEncoder.cs" Link="RecorderCore\FlacEncoder.cs" />
    <Compile Include="..\recorder-agent\LocalArchiveWriter.cs" Link="RecorderCore\LocalArchiveWriter.cs" />
    <Compile Include="..\recorder-agent\RawChunkRecovery.cs" Link="RecorderCore\RawChunkRecovery.cs" />
    <Compile Include="..\recorder-agent\RecordingDeliveryCoordinator.cs" Link="RecorderCore\RecordingDeliveryCoordinator.cs" />
    <Compile Include="..\recorder-agent\RecorderToolPaths.cs" Link="RecorderCore\RecorderToolPaths.cs" />
    <Compile Include="..\recorder-agent\SessionFinalizationCoordinator.cs" Link="RecorderCore\SessionFinalizationCoordinator.cs" />
    <Compile Include="..\recorder-agent\RawChunkFileName.cs" Link="RecorderCore\RawChunkFileName.cs" />
    <Compile Include="..\recorder-agent\GlobalRawEncoderWorker.cs" Link="RecorderCore\GlobalRawEncoderWorker.cs" />
    <Compile Include="..\recorder-agent\RawEncoderRuntimeState.cs" Link="RecorderCore\RawEncoderRuntimeState.cs" />
    <Compile Include="..\recorder-agent\ExternalProcessRunner.cs" Link="RecorderCore\ExternalProcessRunner.cs" />
    <!-- Use the same WASAPI subtype resolver for loopback and microphone
         metadata. The Core project intentionally excludes this NAudio-bound
         file, so Host compiles the shared resolver explicitly. -->
    <Compile Include="..\recorder-agent\AudioSampleFormat.cs" Link="RecorderCore\AudioSampleFormat.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <!-- Render loopback is an independent P2 track. It is intentionally kept
         in Host rather than mixed into AudioGraph microphone capture. -->
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
