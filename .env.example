# WhisperX Atom local Windows/WSL2 Development defaults.
# Do not use this file as a Production secret store.
WHISPERX_DATA_HOST=C:/WhisperXAtom/Data
WHISPERX_INBOX_HOST=C:/WhisperXAtom/Inbox
WHISPERX_ARCHIVE_HOST=C:/WhisperXAtom/Archive
WHISPERX_MODELS_HOST=C:/WhisperXAtom/Models
WHISPERX_UPDATES_HOST=C:/ProgramData/WhisperXAtom/Server/Updates
ASPNETCORE_ENVIRONMENT=Development
WHISPERX_API_BIND_ADDRESS=127.0.0.1
WHISPERX_API_URL=http://127.0.0.1:8080
GPU_WORKER_MODE=host
WHISPERX_HOST_PYTHON=C:/path/to/cuda-venv/Scripts/python.exe
LLM_HEALTH_PORT=18080
POSTGRES_HOST_PORT=55432
NATS_HOST_PORT=4222
NATS_MONITORING_HOST_PORT=8222
POSTGRES_DB=whisperx_atom
POSTGRES_USER=whisperx
POSTGRES_PASSWORD=generate-a-long-random-postgres-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=generate-a-long-random-admin-password
TUS_HOOK_SECRET=replace-with-long-random-secret
IMPORT_WORKER_TOKEN=replace-with-long-random-token
COOKIE_SECURE=false
HF_TOKEN=
WHISPERX_MODEL=large-v3
WHISPERX_MODEL_REPOSITORY=Systran/faster-whisper-large-v3
DEVICE=cuda
COMPUTE_TYPE=float16
REQUIRE_CUDA=true
AUTO_SUMMARY_ENABLED=true
ASSISTANT_ENABLED=true
ASSISTANT_EMBEDDING_PROVIDER=auto
ASSISTANT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ASSISTANT_HYBRID_CANDIDATE_LIMIT=12000
ASSISTANT_HYBRID_MIN_SCORE=0.20
ASSISTANT_HYBRID_EMBEDDING_MIN=0.60
ASSISTANT_EMBEDDING_CACHE=4096
AUTO_SUMMARY_PROFILE=MEETING_PROTOCOL_RU
AUTO_SUMMARY_PROMPT_VERSION=meeting-protocol-ru-v1
DIARIZATION_MODE=preferred
# Optional media safety cap in milliseconds.  0 means unlimited duration;
# recording stops only on an explicit user command or a capture failure.
MAX_MEDIA_DURATION_MS=0

# Retention and disk protection. Zero days means keep the permanent archive indefinitely.
WHISPERX_RETENTION_TRANSPORT_GRACE_HOURS=24
WHISPERX_RETENTION_RAW_GRACE_HOURS=24
WHISPERX_RETENTION_TEMP_HOURS=72
WHISPERX_RETENTION_LOG_DAYS=30
WHISPERX_RETENTION_DIAGNOSTIC_DAYS=14
WHISPERX_RETENTION_LOCAL_MASTER_DAYS=0
WHISPERX_RETENTION_SERVER_ARCHIVE_DAYS=0
WHISPERX_STORAGE_WARNING_PERCENT=15
WHISPERX_STORAGE_CRITICAL_PERCENT=8
WHISPERX_STORAGE_BLOCK_FREE_BYTES=536870912

LLM_MODEL_FILE=Qwen3-8B-Q5_K_M.gguf
LLM_CONTEXT_SIZE=16384
LLM_GPU_LAYERS=99
LLM_DIAGNOSTIC_GPU_LAYERS=99
LLM_REQUIRE_GPU=true
LLM_BASE_URL=http://llama-server:8080/v1

AGENT_ENROLLMENT_SECRET=replace-with-agent-enrollment-secret
WHISPERX_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
ASR_BATCH_SIZE=2
ASR_MAX_BATCH_SIZE=16
DIARIZATION_MODEL_REVISION=replace-with-immutable-diarization-model-commit
LLM_MODEL_REVISION=7c41481f57cb95916b40956ab2f0b139b296d974
LLM_MODEL_SHA256=068BAE163FAA96AD48032DAF4E071A6A28FE67D8DCC95367609C2FF165E52738
VOICE_HOST_TOKEN=replace-with-long-random-voice-host-token

# Isolated LAN profile (use with compose.lan.yml; copy to .env.lan and replace secrets).
LAN_BIND_ADDRESS=192.168.2.194
LAN_SUBNET=192.168.2.0/24
SERVER_ORIGIN=http://192.168.2.194:8080
ALLOW_INSECURE_LAN_HTTP=true
