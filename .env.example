# WhisperX Atom local Windows/WSL2 defaults
WHISPERX_DATA_HOST=D:/WhisperXAtom/Data
WHISPERX_INBOX_HOST=D:/WhisperXAtom/Inbox
WHISPERX_ARCHIVE_HOST=D:/WhisperXAtom/Archive
POSTGRES_DB=whisperx_atom
POSTGRES_USER=whisperx
POSTGRES_PASSWORD=change-me-postgres
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-now
TUS_HOOK_SECRET=replace-with-long-random-secret
IMPORT_WORKER_TOKEN=replace-with-long-random-token
COOKIE_SECURE=false
HF_TOKEN=
WHISPERX_MODEL=large-v3
