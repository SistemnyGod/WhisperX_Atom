# WhisperX Atom local Windows/WSL2 defaults
WHISPERX_DATA_HOST=C:/WhisperXAtom/Data
WHISPERX_INBOX_HOST=C:/WhisperXAtom/Inbox
WHISPERX_ARCHIVE_HOST=C:/WhisperXAtom/Archive
WHISPERX_MODELS_HOST=C:/WhisperXAtom/Models
POSTGRES_DB=whisperx_atom
POSTGRES_USER=whisperx
POSTGRES_PASSWORD=generate-a-long-random-postgres-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=generate-a-long-random-admin-password
TUS_HOOK_SECRET=replace-with-long-random-secret
IMPORT_WORKER_TOKEN=replace-with-long-random-token
COOKIE_SECURE=false
HF_TOKEN=
WHISPERX_MODEL=large-v3

LLM_MODEL_FILE=Qwen3-8B-Q5_K_M.gguf
LLM_CONTEXT_SIZE=32768
LLM_BASE_URL=http://llama-server:8080/v1

AGENT_ENROLLMENT_SECRET=replace-with-agent-enrollment-secret
VOICE_HOST_TOKEN=replace-with-long-random-voice-host-token
