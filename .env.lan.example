# Copy to .env.lan and replace every placeholder before starting the LAN server.
LAN_BIND_ADDRESS=192.168.2.194
SERVER_ORIGIN=http://192.168.2.194:8080
LAN_SUBNET=192.168.2.0/24
ALLOW_INSECURE_LAN_HTTP=true

POSTGRES_DB=whisperx_atom
POSTGRES_USER=whisperx
POSTGRES_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
TUS_HOOK_SECRET=replace-with-a-long-random-secret
IMPORT_WORKER_TOKEN=replace-with-a-long-random-secret
AGENT_ENROLLMENT_SECRET=replace-with-a-long-random-secret
VOICE_HOST_TOKEN=replace-with-a-long-random-secret
HF_TOKEN=replace-with-the-huggingface-token
# Enable only for a controlled legacy rollout; default production is false.
WHISPERX_WAKE_COMPAT_ATOM=false
VOICE_BARGE_IN_MODE=WAKE_ONLY
# OFF, SHADOW, ASSISTANT_ONLY or WAKE_AUDIT; promotion requires corpus evidence.
VOICE_ASR_REFINER_MODE=SHADOW
VOICE_ASR_REFINER_EXECUTABLE=
VOICE_ASR_REFINER_HOST_EXECUTABLE=
VOICE_ASR_REFINER_MODEL=
VOICE_ASR_REFINER_SHA256=
VOICE_ASR_REFINER_NATIVE_LIBRARY=
VOICE_ASR_REFINER_NATIVE_SHA256=
VOICE_ASR_REFINER_MANIFEST=
VOICE_ASR_REFINER_HOST_TIMEOUT_MS=15000
VOICE_ASR_REFINER_CLIENT_TIMEOUT_MS=18000
VOICE_REFINER_THREADS=1
# Legacy alias: used only when the two explicit timeout values are absent.
VOICE_ASR_REFINER_TIMEOUT_MS=
LLM_STREAMING_ENABLED=true

WHISPERX_DATA_HOST=C:/WhisperXAtom/Data
WHISPERX_INBOX_HOST=C:/WhisperXAtom/Inbox
WHISPERX_ARCHIVE_HOST=C:/WhisperXAtom/Archive
WHISPERX_MODELS_HOST=C:/WhisperXAtom/Models
WHISPERX_UPDATES_HOST=C:/ProgramData/WhisperXAtom/Server/Updates

# RTX 5060 Ti 16 GB preset: large-v3 is retained, while int8_float16, a small
# batch and bounded pyannote speaker search keep peak CUDA memory predictable.
WHISPERX_MODEL=large-v3
WHISPERX_MODEL_REPOSITORY=Systran/faster-whisper-large-v3
WHISPERX_MODEL_REVISION=edaa852ec7e145841d8ffdb056a99866b5f0a478
WHISPERX_MODEL_PATH=
WHISPERX_MODEL_SHA256=
WHISPERX_MODEL_LOCAL_ONLY=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_MODEL_REVISION=replace-with-immutable-diarization-model-commit
DIARIZATION_MODEL_PATH=
DIARIZATION_MODEL_SHA256=
# Optional immutable wav2vec alignment artifact. Leave empty only for local
# development; Release Doctor should reject a release without a verified pin.
ALIGNMENT_MODEL=
ALIGNMENT_MODEL_REVISION=
ALIGNMENT_MODEL_PATH=
ALIGNMENT_MODEL_SHA256=
# Qwen snapshot used by Summary/Assistant.  Fill these from the verified
# model manifest; release doctor rejects placeholders and checksum drift.
LLM_MODEL_ROOT=/models
LLM_MODEL_DIR=qwen3-8b
LLM_MODEL_FILE=Qwen3-8B-Q5_K_M.gguf
LLM_MODEL_REVISION=replace-with-immutable-qwen-model-revision
LLM_MODEL_SHA256=replace-with-qwen-model-sha256
COMPUTE_TYPE=int8_float16
BATCH_SIZE=2
ASR_BATCH_SIZE=2
ASR_MAX_BATCH_SIZE=16
ENABLE_ALIGNMENT=true
ENABLE_DIARIZATION=true
DIARIZATION_DEVICE=auto
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=8
DIARIZATION_CPU_FALLBACK=true
DIARIZATION_RELEASE_ASR_ON_LOW_VRAM=true
DIARIZATION_MIN_FREE_VRAM_MB=2048
AUTO_SUMMARY_ENABLED=true
ASSISTANT_ENABLED=true
MEETING_MEMORY_ENABLED=true
MEMORY_MAX_SUBJECTS_PER_JOB=64
MEMORY_MAX_FACTS_PER_SUBJECT=512
MEMORY_MAX_FACTS_PER_JOB=4096
ASSISTANT_EMBEDDING_PROVIDER=onnx
ASSISTANT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ASSISTANT_EMBEDDING_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
ASSISTANT_EMBEDDING_ONNX_PATH=/models/embeddings/paraphrase-multilingual-MiniLM-L12-v2.onnx
ASSISTANT_EMBEDDING_TOKENIZER_PATH=/models/embeddings/tokenizer.json
ASSISTANT_EMBEDDING_ONNX_SHA256=
ASSISTANT_EMBEDDING_TOKENIZER_SHA256=
# Server releases must set this to true and fill both SHA256 values after the
# immutable ONNX/tokenizer snapshot is copied into the model volume.
ASSISTANT_EMBEDDING_REQUIRE_VERIFIED=true
ASSISTANT_FTS_ANCHOR_LIMIT=64
ASSISTANT_SEMANTIC_CANDIDATE_LIMIT=512
ASSISTANT_MEMORY_FALLBACK_LOOKBACK_DAYS=365
ASSISTANT_FINAL_TOP_K=12
ASSISTANT_NEIGHBOUR_LIMIT=36
ASSISTANT_HYBRID_MIN_SCORE=0.30
ASSISTANT_HYBRID_EMBEDDING_MIN=0.72
ASSISTANT_MAX_OUTPUT_TOKENS=384
ASSISTANT_GROUNDING_RETRY_MAX_OUTPUT_TOKENS=512
ASSISTANT_GPU_QUEUE_TIMEOUT_SECONDS=3600
LLM_RESIDENT_ENABLED=true
LLM_WARMUP_ENABLED=true
LLM_WARMUP_IDLE_SECONDS=30
TRANSCRIPTION_START_DELAY_SECONDS=0
WHISPERX_STORAGE_POSTPROCESSING_RESERVE_BYTES=1073741824
WHISPERX_STORAGE_EMERGENCY_STOP_FREE_BYTES=1207959552
SUPERVISOR_HEALTH_TOKEN=replace-with-a-long-random-runtime-health-token
ASSISTANT_QUEUE_TIMEOUT_SECONDS=3600
LLM_IDLE_UNLOAD_SECONDS=900
ASSISTANT_EMBEDDING_CACHE=4096
MAX_MEDIA_DURATION_MS=0
AUTO_SUMMARY_PROFILE=MEETING_PROTOCOL_RU
GPU_WORKER_MODE=container
REQUIRE_CUDA=true
