<Window x:Class="WhisperX.Atom.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WhisperX Atom" Width="1440" Height="900" MinWidth="1180" MinHeight="720"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Background" Value="#E6F4F1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceStrongBrush}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="WhisperX Atom" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Запись, обработка и история совещаний в одном приложении" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E8F6EF" BorderBrush="#B8DDCA" BorderThickness="1" CornerRadius="14" Padding="12,7" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#159B94" Margin="0,0,7,0"/><TextBlock x:Name="AgentStatusText" Text="Проверка службы записи" Foreground="#176A4C" Margin="0"/></StackPanel>
                </Border>
                <Border Background="#E6F4F1" BorderBrush="#A7CBC4" BorderThickness="1" CornerRadius="14" Padding="12,7">
                    <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#159B94" Margin="0,0,7,0"/><TextBlock x:Name="ServerStatusText" Text="Проверка сервера" Foreground="#117A74" Margin="0"/></StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainNavigationTabs" Grid.Row="1" TabStripPlacement="Left" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}">
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Главная" Margin="0"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24,28,28">
                    <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Рабочая панель" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Начните запись или вернитесь к последнему совещанию" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                        <Button Grid.Column="1" x:Name="ImportButton" Content="Импортировать файл" Click="ImportFileButton_Click" Background="#147A74"/>
                    </Grid>
                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,18">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Запись совещания" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RecordingStateText" Text="Ожидание" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,4"/>
                                <TextBlock x:Name="SessionText" Text="Новая запись ещё не начата" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBlock x:Name="ProcessingStatusText" Text="Обработка не запущена" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,4"/>
                                <ProgressBar x:Name="ProcessingProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                                <TextBlock x:Name="ProcessingErrorText" Text="" Foreground="{StaticResource WarningBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" MinWidth="260" Margin="24,0,0,0">
                                <TextBlock Text="Название записи" Foreground="{StaticResource MutedTextBrush}"/>
                                <TextBox x:Name="RecordingTitleBox" ToolTip="Название можно изменить позже" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Микрофон: Windows по умолчанию" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,16,8"/><TextBlock Text="Системный звук: Windows по умолчанию" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="StartRecordingButton" Content="Начать запись" Click="StartButton_Click" Style="{StaticResource PrimaryButton}" MinWidth="150"/>
                                    <Button x:Name="PauseRecordingButton" Content="Пауза" Click="PauseButton_Click"/>
                                    <Button x:Name="ResumeRecordingButton" Content="Продолжить" Click="ResumeButton_Click"/>
                                    <Button x:Name="StopRecordingButton" Content="Завершить" Click="StopButton_Click" Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,9,0">
                            <StackPanel><TextBlock Text="Состояние устройств" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="MicrophoneText" Text="Микрофон: проверка"/><TextBlock x:Name="SystemAudioText" Text="Системный звук: проверка"/><TextBlock x:Name="StorageText" Text="Диск: проверка"/><TextBlock x:Name="DeviceErrorText" Text="" Foreground="{StaticResource WarningBrush}"/></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="9,0,0,0">
                            <StackPanel><TextBlock Text="Система" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Запись работает локально и не зависит от открытого окна приложения" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/><TextBlock x:Name="LastErrorText" Text="" Foreground="{StaticResource DangerBrush}" Margin="0,10,0,0"/></StackPanel>
                        </Border>
                    </Grid>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Совещания" Margin="0"/></StackPanel></TabItem.Header>
                <Grid Margin="22">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="Совещания" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="История записей и импорт файлов" Foreground="{StaticResource MutedTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,6"><Button Content="Обновить" Click="LoadMeetingsButton_Click"/><Button Content="Импортировать" Click="ImportFileButton_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
                        <TextBlock x:Name="ImportStatusText" Text="Выберите аудио или видеофайл" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox x:Name="MeetingSearchBox" ToolTip="Поиск по названию или статусу" TextChanged="MeetingSearchBox_TextChanged" Margin="0,8,0,8"/>
                        <TextBlock x:Name="MeetingCountText" Text="Совещания ещё не загружены" Foreground="{StaticResource MutedTextBrush}"/>
                        <ListBox x:Name="MeetingsList" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Auto" DisplayMemberPath="Title" SelectionChanged="MeetingsList_SelectionChanged"/>
                        <TextBox x:Name="NewMeetingTitleBox" Visibility="Collapsed"/>
                    </StackPanel>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <StackPanel><TextBlock Text="Выбранное совещание" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="SelectedMeetingTitle" Text="Выберите совещание слева" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="SelectedMeetingStatus" Text="" Foreground="{StaticResource MutedTextBrush}"/></StackPanel>
                        </Border>
                        <TabControl Grid.Row="1" Background="{StaticResource SurfaceBrush}">
                            <TabItem Header="Обзор"><TextBlock Text="Выберите раздел стенограммы, саммари, решений или поручений ниже." Margin="20" Foreground="{StaticResource MutedTextBrush}"/></TabItem>
                            <TabItem Header="Стенограмма"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="TranscriptStatusText" Text="Стенограмма ещё не готова" Foreground="{StaticResource MutedTextBrush}"/><ListView x:Name="TranscriptList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="TranscriptList_SelectionChanged"><ListView.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="{Binding TimeLabel}" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Grid.Column="1" Text="{Binding Speaker}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap"/></Grid></DataTemplate></ListView.ItemTemplate></ListView></Grid></TabItem>
                            <TabItem Header="Плеер"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><MediaElement x:Name="PreviewPlayer" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" MediaFailed="PreviewPlayer_MediaFailed"/><Slider x:Name="PositionSlider" Grid.Row="1" Minimum="0" Maximum="1" ValueChanged="PositionSlider_ValueChanged" Margin="0,12,0,8"/><StackPanel Grid.Row="2" Orientation="Horizontal"><Button Content="Воспроизвести" Click="PlayButton_Click"/><Button Content="Пауза" Click="PlayerPauseButton_Click"/><Button Content="Стоп" Click="PlayerStopButton_Click"/><TextBlock x:Name="PlayerStatusText" Text="Плеер не загружен" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/></StackPanel></Grid></TabItem>
                            <TabItem Header="Спикеры"><Grid Margin="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions><ListView x:Name="SpeakerList" Grid.Column="0" SelectionChanged="SpeakerList_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="Ключ" Width="160" DisplayMemberBinding="{Binding StableKey}"/><GridViewColumn Header="Имя" Width="260" DisplayMemberBinding="{Binding DisplayName}"/></GridView></ListView.View></ListView><StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="Спикер" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="SpeakerNameBox"/><Button Content="Переименовать" Click="RenameSpeakerButton_Click"/><TextBlock Text="Объединить кластеры" Margin="0,12,0,4"/><ComboBox x:Name="MergeSourceBox" DisplayMemberPath="DisplayName" Margin="0,0,0,6"/><ComboBox x:Name="MergeTargetBox" DisplayMemberPath="DisplayName" Margin="0,0,0,6"/><Button Content="Объединить" Click="MergeSpeakersButton_Click"/></StackPanel></Grid></TabItem>
                            <TabItem Header="Саммари"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="SummaryTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F8FBFA" Foreground="{StaticResource TextBrush}" Padding="14"/><Button Grid.Row="1" Content="Пересобрать саммари" Click="RebuildSummaryButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"/></Grid></TabItem>
                            <TabItem Header="Решения"><ListView x:Name="DecisionList" Margin="14"><ListView.View><GridView><GridViewColumn Header="Решение" Width="600" DisplayMemberBinding="{Binding Text}"/><GridViewColumn Header="Статус" Width="150" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView></TabItem>
                            <TabItem Header="Поручения"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ListView x:Name="TaskList" SelectionChanged="TaskList_SelectionChanged"><ListView.View><GridView><GridViewColumn Header="Поручение" Width="420" DisplayMemberBinding="{Binding Task}"/><GridViewColumn Header="Ответственный" Width="180" DisplayMemberBinding="{Binding Responsible}"/><GridViewColumn Header="Статус" Width="150" DisplayMemberBinding="{Binding Status}"/></GridView></ListView.View></ListView><Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TaskEditBox" Grid.Column="0" Margin="0,0,8,0" ToolTip="Описание поручения"/><TextBox x:Name="TaskResponsibleBox" Grid.Column="1" Margin="0,0,8,0" ToolTip="Ответственный"/><TextBox x:Name="TaskDeadlineBox" Grid.Column="2" Margin="0,0,8,0" ToolTip="Срок: ГГГГ-ММ-ДД ЧЧ:ММ"/><ComboBox x:Name="TaskStatusBox" Grid.Column="3" Margin="0,0,8,0"><ComboBoxItem Content="NEEDS_REVIEW"/><ComboBoxItem Content="OPEN"/><ComboBoxItem Content="DONE"/><ComboBoxItem Content="CANCELLED"/></ComboBox><Button Grid.Column="4" Content="Сохранить" Click="SaveTaskButton_Click" Style="{StaticResource PrimaryButton}"/></Grid></Grid></TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◈" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Источники" Margin="0"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
                    <TextBlock Text="Источники записи" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Recorder Agent и локальные устройства, которые передают записи в рабочий контур." Foreground="{StaticResource MutedTextBrush}"/>
                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,18,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Состояние источника" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Текущее состояние Agent и API отображается в верхней панели приложения." Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="Для записи нужен подключённый Windows Recorder Agent." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="Обновить состояния" Click="RefreshButton_Click" Style="{StaticResource PrimaryButton}" VerticalAlignment="Top"/></Grid></Border>
                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22"><StackPanel><TextBlock Text="Регистрация нового Agent" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Имя Agent и enrollment secret находятся в разделе Настройки → Инженерные настройки, чтобы основной экран оставался спокойным." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="✓" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Поручения" Margin="0"/></StackPanel></TabItem.Header>
                <StackPanel Margin="28"><TextBlock Text="Поручения" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Задачи выбранного совещания. Откройте совещание, чтобы увидеть evidence и таймкод." Foreground="{StaticResource MutedTextBrush}"/><Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="22" Margin="0,18,0,0"><StackPanel><TextBlock Text="Быстрый доступ" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Для работы с поручением откройте его совещание в разделе «Совещания». Там доступны статус, ответственный, срок и исходная реплика." Foreground="{StaticResource MutedTextBrush}"/><Button Content="Открыть совещания" Click="LoadMeetingsButton_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Border></StackPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Помощник" Margin="0"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
                    <TextBlock Text="Голосовой помощник" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Локальные команды работают без браузера. Вопросы по истории передаются Qwen после обработки." Foreground="{StaticResource MutedTextBrush}"/>
                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,18,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Состояние помощника" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Экспериментальный режим до завершения микрофонной приёмки" Foreground="{StaticResource WarningBrush}"/><TextBlock x:Name="VoiceStateText" Text="SessionHost не подключён" Foreground="{StaticResource AccentBrush}"/><TextBlock x:Name="VoiceReadinessText" Text="Модель, микрофон и служба записи: проверка" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="VoiceMetricsText" Text="Метрики ещё не получены" Foreground="{StaticResource MutedTextBrush}"/><TextBlock x:Name="VoiceLastText" Text="Команда ещё не распознана" Foreground="{StaticResource AccentBrush}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><CheckBox x:Name="VoiceEnabledCheckBox" Content="Включён" IsChecked="True" Checked="VoiceEnabledCheckBox_Changed" Unchecked="VoiceEnabledCheckBox_Changed"/><CheckBox x:Name="VoiceQuietCheckBox" Content="Тихий режим" Checked="VoiceQuietCheckBox_Changed" Unchecked="VoiceQuietCheckBox_Changed"/><Button Content="Обновить" Click="VoiceRefreshButton_Click"/></StackPanel></Grid></Border>
                    <StackPanel Orientation="Horizontal"><Button x:Name="VoicePttButton" Content="Нажмите и говорите" PreviewMouseLeftButtonDown="VoicePttButton_Down" PreviewMouseLeftButtonUp="VoicePttButton_Up" MouseLeave="VoicePttButton_Leave" Background="#147A74" MinWidth="190"/><ComboBox x:Name="VoiceSensitivityBox" Width="130" SelectedIndex="1" SelectionChanged="VoiceSensitivityBox_SelectionChanged"><ComboBoxItem Content="low"/><ComboBoxItem Content="balanced"/><ComboBoxItem Content="high"/></ComboBox><Button Content="Проверить звук" Click="VoiceTtsButton_Click"/><Button x:Name="VoiceDoctorButton" Content="Проверить помощник" Click="VoiceDoctorButton_Click"/></StackPanel>
                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Текстовая команда" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal"><TextBox x:Name="VoiceTextBox" Width="420"/><Button Content="Выполнить" Click="VoiceTextButton_Click"/></StackPanel><TextBlock x:Name="VoiceErrorText" Text="" Foreground="{StaticResource DangerBrush}"/></StackPanel><StackPanel Grid.Column="1" Margin="20,0,0,0"><TextBlock Text="Вопрос по готовым совещаниям" FontSize="17" FontWeight="SemiBold"/><TextBox x:Name="AssistantQuestionBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/><Button Content="Спросить по истории" Click="AssistantQuestionButton_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"/><TextBlock x:Name="AssistantAnswerText" Text="Ответ появится после обработки запроса."/><TextBlock x:Name="AssistantEvidenceText" Text="Evidence появится здесь." Foreground="{StaticResource MutedTextBrush}"/></StackPanel></Grid></Border>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"/><TextBlock Text="Настройки" Margin="0"/></StackPanel></TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
                    <TextBlock Text="Настройки" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Повседневные параметры приложения не требуют доступа к backend." Foreground="{StaticResource MutedTextBrush}"/>
                    <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,18,0,14"><StackPanel><TextBlock Text="Запись" FontSize="17" FontWeight="SemiBold"/><CheckBox Content="Микрофон: Windows по умолчанию" IsChecked="True" IsEnabled="False"/><CheckBox Content="Системный звук: Windows по умолчанию" IsChecked="True" IsEnabled="False"/><CheckBox Content="Тихий режим голосового помощника" IsEnabled="False" ToolTip="Настройка доступна в разделе Помощник"/></StackPanel></Border>
                    <Expander x:Name="EngineeringPanel" IsEnabled="False" Header="Инженерные настройки" Foreground="{StaticResource WarningBrush}" Padding="0" IsExpanded="False"><StackPanel Margin="0,12,0,0"><TextBlock Text="Этот раздел предназначен для диагностики локального API, Docker/WSL2 и Recorder Service." Foreground="{StaticResource MutedTextBrush}"/><Grid Margin="0,12,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions><Label Content="API URL"/><TextBox x:Name="ApiUrlTextBox" Grid.Column="1" Text="http://localhost:8080" Margin="10,0,14,8"/><Label Grid.Column="2" Content="Пользователь"/><TextBox x:Name="UsernameTextBox" Grid.Column="3" Text="admin" Margin="10,0,14,8"/><Label Grid.Column="4" Content="Пароль"/><PasswordBox x:Name="PasswordBox" Grid.Column="5" Margin="10,0,0,8"/></Grid><StackPanel Orientation="Horizontal"><Button Content="Войти в API" Click="LoginButton_Click" Style="{StaticResource PrimaryButton}"/><Button Content="Проверить backend" Click="CheckServerButton_Click"/><Button Content="Диагностика Docker" Click="DockerStatusButton_Click"/></StackPanel><TextBlock x:Name="AdminStatusText" Text="Инженерный режим не активирован" Foreground="{StaticResource MutedTextBrush}"/><Grid Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="Имя Agent"/><TextBox x:Name="AgentNameBox" Grid.Column="1" Text="WhisperX Atom Desktop" Margin="10,0,14,8"/><Label Grid.Column="2" Content="Enrollment secret"/><PasswordBox x:Name="EnrollmentSecretBox" Grid.Column="3" Margin="10,0,14,8"/><Button Grid.Column="4" Content="Зарегистрировать" Click="EnrollAgentButton_Click"/></Grid><StackPanel Orientation="Horizontal"><Button Content="Открыть данные сервера" Click="OpenDataFolderButton_Click"/><Button Content="Открыть spool Agent" Click="OpenAgentSpoolButton_Click"/><Button Content="Открыть журнал помощника" Click="VoiceOpenLogButton_Click"/></StackPanel></StackPanel></Expander>
                </StackPanel></ScrollViewer>
            </TabItem>
        </TabControl>

