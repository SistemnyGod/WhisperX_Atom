<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Keep restored packages inside the ignored release workspace.  Once
         populated, repeated local/CI restores no longer depend on a user
         profile cache and tolerate a temporarily unavailable package feed. -->
    <add key="globalPackagesFolder" value="artifacts/nuget-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
